%=============================================================================
% Members  \stpMember{type}{A}{B}[endA][endB]
%   beam / fiber — bending member; rigid joints by default (no hinge dots);
%                  optional solid end dots mark continuous-beam joints
%   truss        — axial-only; hinged by default; hollow circles at both ends
%                  (same as Example.pdf / sa2hinge)
%   rod          — axial bar (MY_CAE_MEMBER_KIND=ROD); dark-blue; LW = truss
%                  End DOF marks: default thin full circle; for multi-beam
%                  joints use \stpRodPin{gap}{…} (partial circle). Pass [1] on
%                  that end of \stpMember{rod} to suppress the default full pin.
%   ghost        — dashed member
%   endA/endB: beam/fiber → 1 = solid end dot;
%              truss/rod → 0 = draw end mark (default), nonzero = suppress
%=============================================================================
\newcommand{\stp@hingeHollow}[1]{%
  \fill[white] (#1) circle[radius=\stpHingeR];%
  \draw[stpNormal] (#1) circle[radius=\stpHingeR];%
}
% Rod end pin — full thin circle (default)
\newcommand{\stp@rodPinFull}[1]{%
  \fill[white] (#1) circle[radius=\stpHingeR];%
  \draw[stpRodPin] (#1) circle[radius=\stpHingeR];%
}
% Rod end pin — partial circle on the rod side of a multi-beam joint
% (same geometry as \stp@hingeGap; stroke uses thin \stpClrRod)
% #1=joint #2=beamA #3=beamB #4=rodOther (far end of the rod)
\newcommand{\stp@rodPinGap}[4]{%
  \pgfmathsetlengthmacro{\stp@hr}{\stpHingeR+\stpTinyLW}%
  \xdef\stp@side{0}%
  \path let \p{a}=(#2), \p{j}=(#1), \p{b}=(#3), \p{t}=(#4) in
    \pgfextra{%
      \pgfmathtruncatemacro{\stp@sidetmp}{%
        ((\x{b}-\x{a})/1cm)*((\y{t}-\y{j})/1cm)
        -((\y{b}-\y{a})/1cm)*((\x{t}-\x{j})/1cm) > 0 ? 1 : 0}%
      \xdef\stp@side{\stp@sidetmp}%
    };%
  \begin{scope}[even odd rule]
    \ifnum\stp@side=1
      \clip (#1)--(#2)--($(#2)!\stp@hr!90:(#1)$)--
        ($(#3)!\stp@hr!-90:(#1)$)--(#3)--cycle;%
    \else
      \clip (#1)--(#2)--($(#2)!\stp@hr!-90:(#1)$)--
        ($(#3)!\stp@hr!90:(#1)$)--(#3)--cycle;%
    \fi
    \filldraw[fill=white,stpRodPin] (#1) circle[radius=\stpHingeR];%
  \end{scope}%
  % Restore beam chord through the joint (cover circle on the beam side)
  \draw[stpMember] ($ (#1)!\stpHingeR!(#2)$)--(#1)--($ (#1)!\stpHingeR!(#3)$);%
}

\NewDocumentCommand{\stpMember}{m m m O{0} O{0}}{%
  \stpValidTypefalse
  \def\stp@t{#1}%
  \def\stp@tf{fiber}\def\stp@tb{beam}\def\stp@tt{truss}\def\stp@tr{rod}\def\stp@tg{ghost}%
  \ifx\stp@t\stp@tf
    \draw[stpMember] (#2) -- (#3);%
    \coordinate (stp@ba) at ($ (#2)!\stpBarGap!-\stpBarAngle:(#3)$);%
    \coordinate (stp@bb) at ($ (#3)!\stpBarGap!\stpBarAngle:(#2)$);%
    \draw[stpFiber] (stp@ba) -- (stp@bb);%
    \stpValidTypetrue
  \fi
  \ifx\stp@t\stp@tb
    \draw[stpMember] (#2) -- (#3);%
    \stpValidTypetrue
  \fi
  \ifx\stp@t\stp@tt
    \draw[stpTruss] (#2) -- (#3);%
    % Hinged ends: white-filled hollow circles over member tips
    \ifthenelse{\equal{#4}{0}}{\stp@hingeHollow{#2}}{}%
    \ifthenelse{\equal{#5}{0}}{\stp@hingeHollow{#3}}{}%
    \stpValidTypetrue
  \fi
  \ifx\stp@t\stp@tr
    \draw[stpRod] (#2) -- (#3);%
    \ifthenelse{\equal{#4}{0}}{\stp@rodPinFull{#2}}{}%
    \ifthenelse{\equal{#5}{0}}{\stp@rodPinFull{#3}}{}%
    \stpValidTypetrue
  \fi
  \ifx\stp@t\stp@tg
    \draw[stpGhost] (#2) -- (#3);%
    \stpValidTypetrue
  \fi
  \ifstpValidType\else\stp@typeerr{member}{#1}\fi
  % Optional solid end dots for beam/fiber (rigid continuity); not truss/rod
  \ifx\stp@t\stp@tt\else\ifx\stp@t\stp@tr\else
    \ifthenelse{\equal{#4}{0}}{}{\fill[color=\stpClrMember] (#2) circle (\stpHugeLW/2);}%
    \ifthenelse{\equal{#5}{0}}{}{\fill[color=\stpClrMember] (#3) circle (\stpHugeLW/2);}%
  \fi\fi
}
% shortcuts
\newcommand{\stpBeam}[2]{\stpMember{beam}{#1}{#2}}
\newcommand{\stpBeamFiber}[2]{\stpMember{fiber}{#1}{#2}}
\newcommand{\stpTruss}[2]{\stpMember{truss}{#1}{#2}}
\newcommand{\stpRod}[2]{\stpMember{rod}{#1}{#2}}
\newcommand{\stpGhost}[2]{\stpMember{ghost}{#1}{#2}}

% \stpRodPin{full|gap}{point}[beamA][beamB][rodOther]
%   full — thin solid hollow circle (default end mark; same as member end 0)
%   gap  — partial circle on the rod side at a multi-beam joint
%          (beamA–point–beamB = continuous beams; rodOther = far rod node)
% Example:
%   \stpMember{rod}{R1}{J}[0][1]          % suppress full pin at J
%   \stpRodPin{gap}{J}[B1][B2][R1]        % partial pin toward the rod
\NewDocumentCommand{\stpRodPin}{m m O{0} O{0} O{0}}{%
  \stpValidTypefalse
  \def\stp@t{#1}%
  \def\stp@rf{full}\def\stp@rg{gap}%
  \ifx\stp@t\stp@rf
    \stp@rodPinFull{#2}%
    \stpValidTypetrue
  \fi
  \ifx\stp@t\stp@rg
    \stp@rodPinGap{#2}{#3}{#4}{#5}%
    \stpValidTypetrue
  \fi
  \ifstpValidType\else\stp@typeerr{RodPin}{#1}\fi
}
\newcommand{\stpRodPinFull}[1]{\stpRodPin{full}{#1}}
\newcommand{\stpRodPinGap}[4]{\stpRodPin{gap}{#1}[#2][#3][#4]}

%=============================================================================
% Supports — unified 2D BC command (pin/fixed share one entry; keys pick
%            glyph, orientation, and size)
%
% Preferred (keyval):
%   \stpSupport{<point>}[type=..., angle=..., size=..., soft=..., fill=...]
%
% type:
%   wall       hatch wall (single-member end clamp; example-frame)
%   fixed      triangle + filled black tip (multi-member joint fixity)
%   pin        triangle + hollow tip (hinged support)
%   roller     sliding hinge (triangle + double slide gap, no roller wheels;
%              tip hollow by default)
%   spring / elastic — linear elastic support (zigzag)
%   springCoil — coil spring
%   rollerX | slider | torsion | torsionCW
%   *Soft      same glyph without hatching (wallSoft / fixedSoft / …)
%
% angle: local -Y is the ground / spring axis side (degrees)
%        0 = +global Y restraint (spring drawn downward)
% size:  base length (default 12mm); scales triangle/gap/hatch by fixed ratios
% soft:  true → omit hatching
% fill:  black | hollow | auto
%        auto: fixed→black, pin/roller→hollow
% label: optional annotation next to the support (e.g. $k$)
%
% Legacy: \stpSupport{<type>}{<point>}[<angle>]
%   old fixed ≡ wall; use type=fixed (black tip) or type=wall for new meaning
%=============================================================================
\newif\ifstpSupSoft
\def\stp@sup@type{pin}
\def\stp@sup@angle{0}
\def\stp@sup@fill{auto}
\def\stp@sup@label{}

\pgfkeys{
  /stp/support/.cd,
  type/.store in=\stp@sup@type,
  angle/.store in=\stp@sup@angle,
  size/.code={\pgfkeys{/stp/support size=#1}},
  soft/.is if=stpSupSoft,
  soft/.default=true,
  fill/.store in=\stp@sup@fill,
  label/.store in=\stp@sup@label,
  % aliases
  wall/.style={type=wall},
  fixed/.style={type=fixed},
  pin/.style={type=pin},
  roller/.style={type=roller},
  spring/.style={type=spring},
  elastic/.style={type=spring},
  springCoil/.style={type=springCoil},
}

% #1=point  #2=keyvals
\newcommand{\stp@supportKV}[2]{%
  \stpSupSoftfalse
  \def\stp@sup@type{pin}%
  \def\stp@sup@angle{0}%
  \def\stp@sup@fill{auto}%
  \def\stp@sup@label{}%
  \pgfkeys{/stp/support/.cd,#2}%
  \stp@supportDraw{#1}{\stp@sup@type}{\stp@sup@angle}{\stp@sup@fill}%
}

% Legacy type names → new semantics (fixed stays hatch wall for old figures)
\newcommand{\stp@supportLegacy}[3]{%
  \stpSupSoftfalse
  \def\stp@sup@fill{auto}%
  \def\stp@sup@label{}%
  \def\stp@t{#1}%
  \def\stp@map{#1}%
  \def\stp@sFixed{fixed}\def\stp@sFixedS{fixedSoft}%
  \def\stp@sWall{wall}\def\stp@sWallS{wallSoft}%
  \def\stp@sPin{pin}\def\stp@sPinS{pinSoft}%
  \def\stp@sRoll{roller}\def\stp@sRollS{rollerSoft}%
  \def\stp@sSpr{spring}\def\stp@sSprS{springSoft}%
  \def\stp@sEla{elastic}\def\stp@sFJ{fixedJoint}%
  \ifx\stp@t\stp@sFixed\def\stp@map{wall}\fi
  \ifx\stp@t\stp@sFixedS\def\stp@map{wall}\stpSupSofttrue\fi
  \ifx\stp@t\stp@sWall\def\stp@map{wall}\fi
  \ifx\stp@t\stp@sWallS\def\stp@map{wall}\stpSupSofttrue\fi
  \ifx\stp@t\stp@sFJ\def\stp@map{fixed}\fi
  \ifx\stp@t\stp@sPinS\def\stp@map{pin}\stpSupSofttrue\fi
  \ifx\stp@t\stp@sRollS\def\stp@map{roller}\stpSupSofttrue\fi
  \ifx\stp@t\stp@sEla\def\stp@map{spring}\fi
  \ifx\stp@t\stp@sSprS\def\stp@map{spring}\stpSupSofttrue\fi
  \stp@supportDraw{#2}{\stp@map}{#3}{\stp@sup@fill}%
}

% Dual signature: \stpSupport{pt}[keys]  or  \stpSupport{type}{pt}[ang]
% (no xparse g — removed from the LaTeX kernel)
\newcommand{\stpSupport}[1]{%
  \@ifnextchar\bgroup{\stp@sup@leg{#1}}{\stp@sup@kv{#1}}%
}
\def\stp@sup@leg#1#2{%
  \@ifnextchar[{\stp@sup@legA{#1}{#2}}{\stp@sup@legA{#1}{#2}[0]}%
}
\def\stp@sup@legA#1#2[#3]{\stp@supportLegacy{#1}{#2}{#3}}
\def\stp@sup@kv#1{%
  \@ifnextchar[{\stp@sup@kvA{#1}}{\stp@sup@kvA{#1}[]}%
}
\def\stp@sup@kvA#1[#2]{\stp@supportKV{#1}{#2}}

\newcommand{\stp@supportDraw}[4]{%
  \edef\stp@t{#2}%
  \edef\stp@ang{#3}%
  \edef\stp@ff{#4}%
  \begin{scope}[rotate around={\stp@ang:(#1)}]%
    \stpValidTypefalse
    \def\stp@sWall{wall}\def\stp@sFixed{fixed}\def\stp@sPin{pin}%
    \def\stp@sRoll{roller}\def\stp@sRollX{rollerX}\def\stp@sSlide{slider}%
    \def\stp@sSpr{spring}\def\stp@sSprC{springCoil}%
    \def\stp@sTor{torsion}\def\stp@sTorCW{torsionCW}%
    \ifx\stp@t\stp@sWall
      \ifstpSupSoft\stp@supWall{#1}{0}\else\stp@supWall{#1}{1}\fi
      \stpValidTypetrue\fi
    \ifx\stp@t\stp@sFixed
      \stp@resolveFill{\stp@ff}{black}%
      \ifstpSupSoft\stp@supTri{#1}{0}{\stp@fillUse}\else\stp@supTri{#1}{1}{\stp@fillUse}\fi
      \stpValidTypetrue\fi
    \ifx\stp@t\stp@sPin
      \stp@resolveFill{\stp@ff}{hollow}%
      \ifstpSupSoft\stp@supTri{#1}{0}{\stp@fillUse}\else\stp@supTri{#1}{1}{\stp@fillUse}\fi
      \stpValidTypetrue\fi
    \ifx\stp@t\stp@sRoll
      \stp@resolveFill{\stp@ff}{hollow}%
      \ifstpSupSoft\stp@supRoller{#1}{0}{\stp@fillUse}\else\stp@supRoller{#1}{1}{\stp@fillUse}\fi
      \stpValidTypetrue\fi
    \ifx\stp@t\stp@sRollX
      \stp@resolveFill{\stp@ff}{hollow}%
      \begin{scope}[rotate around={90:(#1)}]%
        \ifstpSupSoft\stp@supRoller{#1}{0}{\stp@fillUse}\else\stp@supRoller{#1}{1}{\stp@fillUse}\fi
      \end{scope}%
      \stpValidTypetrue\fi
    \ifx\stp@t\stp@sSlide\stp@supSlider{#1}\stpValidTypetrue\fi
    \ifx\stp@t\stp@sSpr\stp@supSpring{#1}{0}\stpValidTypetrue\fi
    \ifx\stp@t\stp@sSprC\stp@supSpring{#1}{1}\stpValidTypetrue\fi
    \ifx\stp@t\stp@sTor\stp@supTorsion{#1}{0}\stpValidTypetrue\fi
    \ifx\stp@t\stp@sTorCW\stp@supTorsion{#1}{1}\stpValidTypetrue\fi
    \ifstpValidType\else\stp@typeerr{support}{\stp@t}\fi
    \stp@supportLabel{#1}%
  \end{scope}}

% Optional support label (key: label=...)
\newcommand{\stp@supportLabel}[1]{%
  \ifx\stp@sup@label\stp@empty\else
    \edef\stp@styp{\stp@sup@type}%
    \def\stp@sSpr{spring}\def\stp@sSprC{springCoil}%
    \ifx\stp@styp\stp@sSpr
      \node[stpLabel, anchor=west]
        at ($ (#1)+(\stpSupBasicL/2+1.2mm,{-\stpSpringL/2})$) {\stp@sup@label};%
    \else\ifx\stp@styp\stp@sSprC
      \node[stpLabel, anchor=west]
        at ($ (#1)+(\stpSupBasicL/2+1.2mm,{-\stpCoilL/2})$) {\stp@sup@label};%
    \else
      \node[stpLabel, anchor=north]
        at ($ (#1)+(0,{-\stpSupH-\stpSupBasicH-1.5mm})$) {\stp@sup@label};%
    \fi\fi
  \fi
}

% #1=requested fill (auto|black|hollow)  #2=default when auto
\newcommand{\stp@resolveFill}[2]{%
  \edef\stp@freq{#1}%
  \edef\stp@fdef{#2}%
  \def\stp@fauto{auto}\def\stp@fblk{black}\def\stp@fhol{hollow}%
  \ifx\stp@freq\stp@fauto\let\stp@fillUse\stp@fdef
  \else\ifx\stp@freq\stp@fblk\def\stp@fillUse{black}%
  \else\ifx\stp@freq\stp@fhol\def\stp@fillUse{hollow}%
  \else\let\stp@fillUse\stp@fdef\fi\fi\fi
}

% Tip at support apex: always hollow (no solid black disks)
\newcommand{\stp@drawTipCircle}[2]{%
  \fill[white] (#1) circle[radius=\stpHingeR];%
  \draw[stpNormal] (#1) circle[radius=\stpHingeR];%
}

% Hatch wall: baseline through node, hatch on local -Y; #2=1 hatch / 0 soft double line
\newcommand{\stp@supWall}[2]{%
  \ifthenelse{\equal{#2}{1}}{%
    \draw[stpNormal] ($ (#1)+(\stpSupBasicL/2,0)$) -- ++(-\stpSupBasicL,0);%
    \begin{scope}
      \clip ($ (#1)+(-\stpSupBasicL/2,-\stpSupBasicH)$)
        rectangle ($ (#1)+(\stpSupBasicL/2,0)$);%
      \draw[stpHatch] ($ (#1)+(\stpSupHatchL/2,0)$) -- ++(-\stpSupHatchL,0);%
    \end{scope}
  }{%
    \draw[stpNormal] ($ (#1)+(\stpSupBasicL/2,0)$) -- ++(-\stpSupBasicL,0);%
    \draw[stpNormal] ($ (#1)+(\stpSupBasicL/2,-\stpSupGap)$) -- ++(-\stpSupBasicL,0);%
    \begin{scope}
      \clip ($ (#1)+(-\stpSupBasicL/2,-\stpSupBasicH-\stpSupGap)$)
        rectangle ($ (#1)+(\stpSupBasicL/2,-\stpSupGap)$);%
      \draw[stpHatch] ($ (#1)+(\stpSupHatchL/2,-\stpSupGap)$) -- ++(-\stpSupHatchL,0);%
    \end{scope}
  }%
}
% Legacy alias
\newcommand{\stp@supFixed}[2]{\stp@supWall{#1}{#2}}

% Triangle support + tip circle: #2=1 hatch, #3=black|hollow
\newcommand{\stp@supTri}[3]{%
  \draw[stpNormal] (#1)
    -- ++(\stpSupL/2,-\stpSupH-\stpSupGap)
    -- ++(-\stpSupL,0) -- cycle;%
  \draw[stpNormal] ($ (#1)+(\stpSupBasicL/2,-\stpSupH-\stpSupGap)$)
    -- ++(-\stpSupBasicL,0);%
  \ifthenelse{\equal{#2}{1}}{%
    \begin{scope}
      \clip ($ (#1)+(-\stpSupBasicL/2,-\stpSupBasicH-\stpSupH-\stpSupGap)$)
        rectangle ($ (#1)+(\stpSupBasicL/2,-\stpSupH-\stpSupGap)$);%
      \draw[stpHatch]
        ($ (#1)+(\stpSupHatchL/2,-\stpSupHatchH-\stpSupGap)$)
        -- ++(-\stpSupHatchL,0);%
    \end{scope}
  }{}%
  \stp@drawTipCircle{#1}{#3}%
}
\newcommand{\stp@supPin}[2]{\stp@supTri{#1}{#2}{hollow}}

% Sliding hinge: triangle + double slide gap, no roller wheels
% #2=1 hatch, #3=black|hollow (tip circle)
\newcommand{\stp@supRoller}[3]{%
  \draw[stpNormal] (#1)
    -- ++(\stpSupL/2,-\stpSupH)
    -- ++(-\stpSupL,0) -- cycle;%
  \draw[stpNormal] ($ (#1)+(\stpSupBasicL/2,-\stpSupH)$)
    -- ++(-\stpSupBasicL,0);%
  \draw[stpNormal] ($ (#1)+(\stpSupBasicL/2,-\stpSupH-\stpSupGap)$)
    -- ++(-\stpSupBasicL,0);%
  \ifthenelse{\equal{#2}{1}}{%
    \begin{scope}
      \clip ($ (#1)+(-\stpSupBasicL/2,-\stpSupBasicH-\stpSupH-\stpSupGap)$)
        rectangle ($ (#1)+(\stpSupBasicL/2,-\stpSupH-\stpSupGap)$);%
      \draw[stpHatch]
        ($ (#1)+(\stpSupHatchL/2,-\stpSupHatchH-\stpSupGap)$)
        -- ++(-\stpSupHatchL,0);%
    \end{scope}
  }{}%
  \stp@drawTipCircle{#1}{#3}%
}

\newcommand{\stp@supSlider}[1]{%
  \draw[stpBC] ($ (#1)+(\stpSupGap/2,\stpSupBasicL/2)$) -- ++(0,-\stpSupBasicL);%
  \draw[stpBC] ($ (#1)+(-\stpSupGap/2,\stpSupBasicL/2)$) -- ++(0,-\stpSupBasicL);%
  \fill[white] (#1) circle[radius=\stpSupGap/1.5];%
  \draw[stpBC] (#1) circle[radius=\stpSupGap/1.5];%
}

% Elastic support. #2=0 zigzag, #2=1 coil.
% Local -Y is the spring axis (angle=0 → global Y restraint).
\newcommand{\stp@supSpring}[2]{%
  \ifthenelse{\equal{#2}{0}}{%
    \draw[stpNormal, decorate,
      decoration={zigzag, amplitude=\stpSpringAmp, segment length=\stpSpringSeg,
        pre length=\stpSpringPre, post length=\stpSpringPost}]
      (#1) -- ++(0,-\stpSpringL);%
    \draw[stpNormal] ($ (#1)+(\stpSupBasicL/2,-\stpSpringL)$)
      -- ++(-\stpSupBasicL,0);%
    \ifstpSupSoft\else
      \begin{scope}
        \clip ($ (#1)+(-\stpSupBasicL/2,-\stpSpringL)$)
          rectangle ++(\stpSupBasicL,-\stpSpringHatchH);%
        \draw[stpHatch] ($ (#1)+(\stpSupHatchL/2,-\stpSpringL)$)
          -- ++(-\stpSupHatchL,0);%
      \end{scope}
    \fi
  }{%
    \draw[stpNormal, decorate,
      decoration={coil, amplitude=\stpCoilAmp, segment length=\stpCoilSeg,
        pre length=\stpCoilPre, post length=\stpCoilPost}]
      (#1) -- ++(0,-\stpCoilL);%
    \draw[stpNormal] ($ (#1)+(\stpSupBasicL/2,-\stpCoilL)$)
      -- ++(-\stpSupBasicL,0);%
    \ifstpSupSoft\else
      \begin{scope}
        \clip ($ (#1)+(-\stpSupBasicL/2,-\stpCoilL)$)
          rectangle ++(\stpSupBasicL,-\stpSpringHatchH);%
        \draw[stpHatch] ($ (#1)+(\stpSupHatchL/2,-\stpCoilL)$)
          -- ++(-\stpSupHatchL,0);%
      \end{scope}
    \fi
  }%
}

\newcommand{\stp@supTorsion}[2]{%
  \pgfmathsetmacro{\stp@ss}{\stpTorR/17.007874}%
  \begin{scope}[scale=\stp@ss]
    \ifthenelse{\equal{#2}{0}}{%
      \draw[stpTor] (#1)
        arc[start angle=-180,end angle=0,radius=0.6mm]
        arc[start angle=0,end angle=180,radius=1.2mm]
        arc[start angle=-180,end angle=0,radius=2mm]
        arc[start angle=0,end angle=180,radius=3mm]
        arc[start angle=-180,end angle=0,radius=4.2mm]
        arc[start angle=0,end angle=180,radius=5.6mm];%
    }{%
      \draw[stpTor] (#1)
        arc[start angle=0,end angle=-180,radius=0.6mm]
        arc[start angle=180,end angle=0,radius=1.2mm]
        arc[start angle=0,end angle=-180,radius=2mm]
        arc[start angle=180,end angle=0,radius=3mm]
        arc[start angle=0,end angle=-180,radius=4.2mm]
        arc[start angle=180,end angle=0,radius=5.6mm];%
    }%
  \end{scope}%
  \draw[stpBC] ($ (#1)+(-\stpTorR-\stpSupBasicL/7,0)$) -- ++(\stpSupBasicL/3.5,0);%
  \begin{scope}
    \clip ($ (#1)+(-\stpTorR-\stpSupBasicL/7,0)$)
      rectangle ++(\stpSupBasicL/3.5,-\stpSupBasicH/2);%
    \draw[stpHatchSoft] (#1) -- ++(-\stpSupHatchL/2,0);%
  \end{scope}%
}

% CAE mask → support
\NewDocumentCommand{\stpSupportFromMask}{m m O{0}}{%
  \edef\stp@bUX{\stp@maskbit{#1}{1}}%
  \edef\stp@bUY{\stp@maskbit{#1}{2}}%
  \edef\stp@bRZ{\stp@maskbit{#1}{6}}%
  \def\stp@typ{none}\def\stp@none{none}%
  \ifnum\stp@bUX=1\ifnum\stp@bUY=1\ifnum\stp@bRZ=1\def\stp@typ{fixed}\fi\fi\fi
  \ifx\stp@typ\stp@none
    \ifnum\stp@bUX=1\ifnum\stp@bUY=1\def\stp@typ{pin}\fi\fi\fi
  \ifx\stp@typ\stp@none
    \ifnum\stp@bUY=1\ifnum\stp@bUX=0\def\stp@typ{roller}\fi\fi\fi
  \ifx\stp@typ\stp@none
    \ifnum\stp@bUX=1\ifnum\stp@bUY=0\def\stp@typ{rollerX}\fi\fi\fi
  \ifx\stp@typ\stp@none
    \ifnum\stp@bRZ=1\def\stp@typ{slider}\fi\fi
  \ifx\stp@typ\stp@none
    \PackageWarning{satopdf}{Mask #1: no 2D mapping}%
  \else\edef\stp@c{\noexpand\stpSupport{\stp@typ}{#2}[#3]}\stp@c\fi
}

% CAE two-circle BC glyph
% Stem must keep mm units: \pgfmathsetmacro strips them → TikZ reads cm.
\NewDocumentCommand{\stpBCMark}{m m O{}}{%
  \stp@unitxy{#2}%
  \coordinate (stp@bc1) at (#1);%
  \coordinate (stp@bc2) at
    ($ (#1)+({-3.2*\stpTipR*\stp@ux},{-3.2*\stpTipR*\stp@uy})$);%
  \fill[white] (stp@bc1) circle[radius=\stpTipR];%
  \fill[white] (stp@bc2) circle[radius=\stpTipR];%
  \draw[stpBC] (stp@bc1) circle[radius=\stpTipR];%
  \draw[stpBC] (stp@bc2) circle[radius=\stpTipR];%
  \draw[stpBC]
    ($ (stp@bc1)+({-\stp@ux*\stpTipR},{-\stp@uy*\stpTipR})$) --
    ($ (stp@bc2)+({\stp@ux*\stpTipR},{\stp@uy*\stpTipR})$);%
  \def\stp@tmp{#3}%
  \ifx\stp@tmp\stp@empty\else
    \node[stpLabel, text=\stpClrBC, anchor=west] at ($ (stp@bc2)+(1.5mm,0)$) {#3};%
  \fi}

%=============================================================================
% Hinges  \stpHinge{type}{point}[…]
%   full | gap | guide | axial | corner
%
% gap (half-hinge at beam–truss joint):
%   \stpHinge{gap}{joint}[beamA][beamB][trussOther]
%   Half-circle is always drawn on the truss side — side is deduced from
%   trussOther (the far end of the truss), no 0/1 orientation switch.
%=============================================================================
% #1=joint #2=beamA #3=beamB #4=trussOther
\newcommand{\stp@hingeGap}[4]{%
  \pgfmathsetlengthmacro{\stp@hr}{\stpHingeR+\stpNormalLW}%
  % Cross (beamA→beamB) × (joint→trussOther): sign = which side truss is on.
  % Default clip (−90 at A, +90 at B) covers the side where cross < 0 for a
  % left→right chord with truss below; flip ±90 when cross > 0.
  \xdef\stp@side{0}%
  \path let \p{a}=(#2), \p{j}=(#1), \p{b}=(#3), \p{t}=(#4) in
    \pgfextra{%
      \pgfmathtruncatemacro{\stp@sidetmp}{%
        ((\x{b}-\x{a})/1cm)*((\y{t}-\y{j})/1cm)
        -((\y{b}-\y{a})/1cm)*((\x{t}-\x{j})/1cm) > 0 ? 1 : 0}%
      \xdef\stp@side{\stp@sidetmp}%
    };%
  \begin{scope}[even odd rule]
    \ifnum\stp@side=1
      \clip (#1)--(#2)--($(#2)!\stp@hr!90:(#1)$)--
        ($(#3)!\stp@hr!-90:(#1)$)--(#3)--cycle;%
    \else
      \clip (#1)--(#2)--($(#2)!\stp@hr!-90:(#1)$)--
        ($(#3)!\stp@hr!90:(#1)$)--(#3)--cycle;%
    \fi
    \filldraw[fill=white,stpNormal] (#1) circle[radius=\stpHingeR];%
  \end{scope}%
  \draw[stpHuge] ($ (#1)!\stpHingeR!(#2)$)--(#1)--($ (#1)!\stpHingeR!(#3)$);%
}

\NewDocumentCommand{\stpHinge}{m m O{0} O{0} O{0}}{%
  \stpValidTypefalse
  \def\stp@t{#1}%
  \def\stp@hFull{full}\def\stp@hGap{gap}\def\stp@hGuide{guide}%
  \def\stp@hAxial{axial}\def\stp@hCorner{corner}%
  \ifx\stp@t\stp@hFull
    \fill[white] (#2) circle[radius=\stpHingeR];%
    \draw[stpNormal] (#2) circle[radius=\stpHingeR];%
    \stpValidTypetrue
  \fi
  \ifx\stp@t\stp@hGap
    \stp@hingeGap{#2}{#3}{#4}{#5}%
    \stpValidTypetrue
  \fi
  \ifx\stp@t\stp@hGuide
    \begin{scope}[rotate around={#3:(#2)}]
      \fill[white] (#2) circle[radius=\stpSupGap/1.5];%
      \draw[stpNormal] ($ (#2)+(\stpSupGap/2,\stpSupBasicL/2)$)--++(0,-\stpSupBasicL);%
      \draw[stpNormal] ($ (#2)+(-\stpSupGap/2,\stpSupBasicL/2)$)--++(0,-\stpSupBasicL);%
    \end{scope}%
    \stpValidTypetrue
  \fi
  \ifx\stp@t\stp@hAxial
    \begin{scope}[rotate around={#3:(#2)}]
      \fill[white] ($ (#2)+(-\stpHingeAxialL/3,\stpHingeAxialH/2)$)
        rectangle ($ (#2)+(0,-\stpHingeAxialH/2)$);%
      \draw[stpNormal] ($ (#2)+(2*\stpHingeAxialL/3,\stpHingeAxialH/2)$)
        -- ++(-\stpHingeAxialL,0) -- ++(0,-\stpHingeAxialH)
        -- ++(\stpHingeAxialL,0);%
    \end{scope}%
    \stpValidTypetrue
  \fi
  \ifx\stp@t\stp@hCorner
    \coordinate (stp@ha) at ($ (#2)!\stpHingeCornerL!(#3)$);%
    \coordinate (stp@hb) at ($ (#2)!\stpHingeCornerL!(#4)$);%
    \fill[color=\stpClrMember] (#2)--(stp@ha)--(stp@hb)--cycle;%
    \fill[color=\stpClrMember] (#2) circle (\stpHugeLW/2);%
    \stpValidTypetrue
  \fi
  \ifstpValidType\else\stp@typeerr{hinge}{#1}\fi
}
\newcommand{\stpHingeFull}[1]{\stpHinge{full}{#1}}

%=============================================================================
% Point loads & couples
% \stpLoad{force|moment|momentCW}{point}[rot][len/sweep][gap/radius][label]
% \stpPointLoad{point}{dx,dy}[label]   — CAE vector form, tip circle + pull-back
% \stpCouple{point}{cw|ccw}[label]
% Moment label default: above arc centre, outside the arc (radius + moment label gap)
%=============================================================================
\newcommand{\stpMomLabelGap}{1.8mm}
\pgfkeys{/stp/.cd, moment label gap/.code={\renewcommand{\stpMomLabelGap}{#1}}}

% #1=center #2=radius-macro #3=label
\newcommand{\stp@momentLabel}[3]{%
  \def\stp@mlab{#3}%
  \ifx\stp@mlab\stp@empty\else
    \pgfmathsetlengthmacro{\stp@mly}{#2+\stpMomLabelGap}%
    \node[stpLoadLabel, anchor=south]
      at ($ (#1)+(0,\stp@mly)$) {#3};%
  \fi
}

\NewDocumentCommand{\stpLoad}{m m O{0} O{0} O{0} O{}}{%
  \stpValidTypefalse
  \def\stp@t{#1}%
  \def\stp@lf{force}\def\stp@lm{moment}\def\stp@lc{momentCW}%
  \ifx\stp@t\stp@lf
    \ifthenelse{\equal{#5}{0}}{\def\stp@ga{\stpForceDist}}{\def\stp@ga{#5}}%
    \ifthenelse{\equal{#4}{0}}{\def\stp@lb{\stpForceL}}{\def\stp@lb{#4}}%
    \draw[stpLoadRev] ($ (#2)+(#3:\stp@ga)$) -- ++(#3:\stp@lb);%
    \def\stp@tmp{#6}%
    \ifx\stp@tmp\stp@empty\else
      \node[stpLoadLabel, anchor=south]
        at ($ (#2)+(#3:{\stp@ga+\stp@lb+1.2mm})$) {#6};%
    \fi
    \stpValidTypetrue
  \fi
  \ifx\stp@t\stp@lm
    % #3 rotate, #4 sweep (deg), #5 radius — default radius = half support width
    \ifthenelse{\equal{#5}{0}}{%
      \pgfmathsetlengthmacro{\stp@ga}{0.5*\stpSupL}%
    }{\edef\stp@ga{#5}}%
    \ifthenelse{\equal{#4}{0}}{\edef\stp@lb{\stpMomentAng}}{\edef\stp@lb{#4}}%
    \begin{scope}[rotate around={#3:(#2)}]
      \draw[stpMomentArc]
        ($ (#2)+(\stp@ga,0)$) arc[start angle=0, end angle=\stp@lb, radius=\stp@ga];%
    \end{scope}%
    \stp@momentLabel{#2}{\stp@ga}{#6}%
    \stpValidTypetrue
  \fi
  \ifx\stp@t\stp@lc
    \ifthenelse{\equal{#5}{0}}{%
      \pgfmathsetlengthmacro{\stp@ga}{0.5*\stpSupL}%
    }{\edef\stp@ga{#5}}%
    \ifthenelse{\equal{#4}{0}}{\edef\stp@lb{\stpMomentAng}}{\edef\stp@lb{#4}}%
    \begin{scope}[rotate around={#3:(#2)}]
      \draw[stpMomentArcCW]
        ($ (#2)+(\stp@ga,0)$) arc[start angle=0, end angle=\stp@lb, radius=\stp@ga];%
    \end{scope}%
    \stp@momentLabel{#2}{\stp@ga}{#6}%
    \stpValidTypetrue
  \fi
  \ifstpValidType\else\stp@typeerr{load}{#1}\fi
}

\NewDocumentCommand{\stpPointLoad}{m m O{}}{%
  \stp@unitxy{#2}%
  \coordinate (stp@pc) at (#1);%
  \stp@tipmark{stp@pc}{stp@ptip}%
  \coordinate (stp@ptail) at ($ (stp@pc)+({-\stp@ux*\stpForceL},{-\stp@uy*\stpForceL})$);%
  \draw[stpLoad] (stp@ptail) -- (stp@ptip);%
  \def\stp@tmp{#3}%
  \ifx\stp@tmp\stp@empty\else
    \node[stpLoadLabel, anchor=south] at ($ (stp@ptail)+(0,1.2mm)$) {#3};%
  \fi}

\NewDocumentCommand{\stpCouple}{m m O{}}{%
  \def\stp@sense{#2}\def\stp@cw{cw}%
  \ifx\stp@sense\stp@cw
    \stpLoad{momentCW}{#1}[0][0][0][#3]%
  \else
    \stpLoad{moment}{#1}[0][0][0][#3]%
  \fi
}

%=============================================================================
% Line loads
% \stpLineLoad{type}{A}{B}[endA][endB][interval][label]
%   local  — along member normal, variable ends
%   global — global -Y
%   label  — optional; same as \stpLoad; color from stpScheme
% \stpLineLoadCAE{A}{B}{dx,dy}[label][count]
%=============================================================================
\newcommand{\stpLineLabelGap}{1.8mm}
\pgfkeys{/stp/.cd, lineload label gap/.code={\renewcommand{\stpLineLabelGap}{#1}}}

\NewDocumentCommand{\stpLineLoad}{m m m O{1} O{1} O{\stpLineInterval} O{}}{%
  \stpValidTypefalse
  \def\stp@t{#1}%
  \def\stp@ll{local}\def\stp@lg{global}%
  \edef\stp@lli{#6}%
  \ifx\stp@t\stp@ll
    \coordinate (stp@la1) at ($ (#2)!\stpLineDist!90:(#3)$);%
    \coordinate (stp@lb1) at ($ (#3)!\stpLineDist!-90:(#2)$);%
    \coordinate (stp@la2) at ($ (#2)!{\stpLineDist+#4cm}!90:(#3)$);%
    \coordinate (stp@lb2) at ($ (#3)!{\stpLineDist+#5cm}!-90:(#2)$);%
    \stp@drawLineLoadArrows{\stp@lli}%
    \stp@lineLoadLabel{#7}%
    \stpValidTypetrue
  \fi
  \ifx\stp@t\stp@lg
    \coordinate (stp@la1) at ($ (#2)+(0,\stpLineDist)$);%
    \coordinate (stp@lb1) at ($ (#3)+(0,\stpLineDist)$);%
    \coordinate (stp@la2) at ($ (#2)+(0,\stpLineDist+#4cm)$);%
    \coordinate (stp@lb2) at ($ (#3)+(0,\stpLineDist+#5cm)$);%
    \stp@drawLineLoadArrows{\stp@lli}%
    \stp@lineLoadLabel{#7}%
    \stpValidTypetrue
  \fi
  \ifstpValidType\else\stp@typeerr{lineload}{#1}\fi
}
% Label: mid-point of outer envelope, pushed outward (color from stpScheme)
\newcommand{\stp@lineLoadLabel}[1]{%
  \def\stp@llab{#1}%
  \ifx\stp@llab\stp@empty\else
    \coordinate (stp@lin) at ($ (stp@la1)!0.5!(stp@lb1)$);%
    \coordinate (stp@lout) at ($ (stp@la2)!0.5!(stp@lb2)$);%
    \node[stpLoadLabel, anchor=south]
      at ($ (stp@lout)!-\stpLineLabelGap!(stp@lin)$) {#1};%
  \fi
}
% #1 = nominal spacing fraction along AB (e.g. 0.2).
% Convert to arrow count and place uniformly at t = k/(N-1), including both ends
% (avoids uneven end gaps from float foreach 0.12,0.24,...,0.88).
\newcommand{\stp@drawLineLoadArrows}[1]{%
  \draw[stpLoadRail] (stp@la1) -- (stp@lb1);%
  \draw[stpLoadRail] (stp@la2) -- (stp@lb2);%
  \pgfmathsetmacro{\stp@h}{max(#1,1e-3)}%
  \pgfmathtruncatemacro{\stp@ln}{max(2, round(1/\stp@h)+1)}%
  \pgfmathtruncatemacro{\stp@lm}{\stp@ln-1}%
  \foreach \stp@k in {0,...,\stp@lm} {%
    \pgfmathsetmacro{\stp@t}{\stp@k/\stp@lm}%
    \draw[stpLoad]
      ($ (stp@la2)!\stp@t!(stp@lb2)$) -- ($ (stp@la1)!\stp@t!(stp@lb1)$);%
  }%
  \fill[color=\stpClrLoad] (stp@la2) circle (\stpTinyLW/2);%
  \fill[color=\stpClrLoad] (stp@lb2) circle (\stpTinyLW/2);%
}

\NewDocumentCommand{\stpLineLoadCAE}{m m m O{} O{}}{%
  \stp@unitxy{#3}%
  \if\relax\detokenize{#5}\relax
    \pgfmathtruncatemacro{\stp@N}{\stpLineCount}%
  \else
    \pgfmathtruncatemacro{\stp@N}{#5}%
  \fi
  \coordinate (stp@t0) at ($ (#1)+({-\stp@ux*\stpLineShaft},{-\stp@uy*\stpLineShaft})$);%
  \coordinate (stp@t1) at ($ (#2)+({-\stp@ux*\stpLineShaft},{-\stp@uy*\stpLineShaft})$);%
  \draw[stpLoadPlain] (stp@t0) -- (stp@t1);%
  \foreach \stp@k in {0,...,\numexpr\stp@N-1\relax}{%
    \pgfmathsetmacro{\stp@t}{\stp@k/max(\stp@N-1,1)}%
    \coordinate (stp@lc) at ($ (#1)!\stp@t!(#2)$);%
    \stp@tipmark{stp@lc}{stp@ltip}%
    \coordinate (stp@ltail) at
      ($ (stp@lc)+({-\stp@ux*\stpLineShaft},{-\stp@uy*\stpLineShaft})$);%
    \draw[stpLoad] (stp@ltail) -- (stp@ltip);%
  }%
  \def\stp@tmp{#4}%
  \ifx\stp@tmp\stp@empty\else
    \node[stpLoadLabel, anchor=south]
      at ($ (#1)!0.5!(#2)+({-\stp@ux*(\stpLineShaft+2.5mm)},{-\stp@uy*(\stpLineShaft+2.5mm)})$)
      {#4};%
  \fi}

%=============================================================================
% Springs (standalone, not as support)
%=============================================================================
\NewDocumentCommand{\stpSpringK}{m m O{}}{%
  \begin{scope}[rotate around={#2:(#1)}]
    \fill[white] (#1) circle[radius=\stpTipR];%
    \draw[stpBC] (#1) circle[radius=\stpTipR];%
    \draw[stpSpringZig] ($ (#1)+(0,{-\stpTipR})$) -- ++(0,{-\stpSpringL});%
    \draw[stpBC] ($ (#1)+(0,{-\stpTipR-\stpSpringL})$)
      -- ++(\stpSupL/2,0) -- ++(-\stpSupL,0);%
  \end{scope}%
  \def\stp@tmp{#3}%
  \ifx\stp@tmp\stp@empty\else
    \node[stpLabel, text=\stpClrSpring] at ($ (#1)+(3mm,-8mm)$) {#3};%
  \fi}
\NewDocumentCommand{\stpSpringKR}{m O{}}{%
  \fill[white] (#1) circle[radius=\stpTipR];%
  \draw[stpTor] (#1) circle[radius=\stpTipR];%
  % Same simple -> tip as moment arcs / point loads (not Latex wedge)
  \draw[stpTor, line width=\stpTinyLW, ->]
    (#1) ++(\stpTipR,0) arc[start angle=0,end angle=300,radius=\stpTorR*0.65];%
  \def\stp@tmp{#2}%
  \ifx\stp@tmp\stp@empty\else
    \node[stpLabel, text=\stpClrTor] at ($ (#1)+(5mm,5mm)$) {#2};%
  \fi}

%=============================================================================
% Internal force diagrams (envelope)
% \stpInternalForces{A}{B}{vA}{vB}[parabola][color][bendpos]
% values in cm of offset (perpendicular distance from member to diagram)
% Stroke: thin diagram colour — never beam weight / member colour
%=============================================================================
\NewDocumentCommand{\stpInternalForces}{m m m m O{0} O{\stpClrShear} O{0.6667}}{%
  \coordinate (stp@ifa) at ($ (#1)!#3cm!-90:(#2)$);%
  \coordinate (stp@ifb) at ($ (#2)!#4cm!90:(#1)$);%
  \coordinate (stp@ifab) at ($ (stp@ifa)!.5!(stp@ifb)$);%
  \coordinate (stp@ifc) at ($ (stp@ifab)+2*(0,#5)$);%
  \coordinate (stp@ifac) at ($ (stp@ifa)!#7!(stp@ifc)$);%
  \coordinate (stp@ifbc) at ($ (stp@ifb)!#7!(stp@ifc)$);%
  \ifthenelse{\equal{#5}{0}}{%
    \draw[stpShear, color=#6]
      (#1)--(stp@ifa)--(stp@ifb)--(#2);%
  }{%
    \draw[stpShear, color=#6]
      (#1)--(stp@ifa)
      (stp@ifa) .. controls (stp@ifac) and (stp@ifbc) .. (stp@ifb)
      (stp@ifb)--(#2);%
  }%
  \fill[color=#6] (stp@ifa) circle (\stpTinyLW);%
  \fill[color=#6] (stp@ifb) circle (\stpTinyLW);%
  \fill[color=#6] (#1) circle (\stpTinyLW);%
  \fill[color=#6] (#2) circle (\stpTinyLW);%
}

%=============================================================================
% Moment diagram — CAE / write_cae_results_to_dxf.py
% \stpMomentDiagram[qy=,scale=,label=,color=]{A}{B}{Ms}{Me}
%=============================================================================
\pgfkeys{
  /stp/moment/.cd,
  qy/.estore in=\stp@mom@qy,
  scale/.estore in=\stp@mom@scl,
  label/.estore in=\stp@mom@lab,
  color/.estore in=\stp@mom@clr,
}
\NewDocumentCommand{\stpMomentDiagram}{O{} m m m m}{%
  \pgfkeys{/stp/moment/.cd, qy=0, scale=, label=, color=\stpClrMoment, #1}%
  \pgfmathsetmacro{\stp@Ms}{#4}%
  \pgfmathsetmacro{\stp@Me}{#5}%
  \pgfmathsetmacro{\stp@qy}{\stp@mom@qy}%
  \edef\stp@tmpscl{\stp@mom@scl}%
  \ifx\stp@tmpscl\stp@empty
    \pgfmathsetmacro{\stp@mscl}{\stpMomScale}%
  \else
    \pgfmathsetmacro{\stp@mscl}{\stp@mom@scl}%
  \fi
  \pgfmathtruncatemacro{\stp@ns}{\stpMomSeg}%
  \pgfmathtruncatemacro{\stp@teeth}{\stpMomTeeth}%
  \path let \p1=($(#3)-(#2)$) in \pgfextra{%
    \pgfmathsetmacro{\stp@Ltmp}{veclen(\x1,\y1)/1mm}%
    \xdef\stp@L{\stp@Ltmp}};%
  \pgfmathsetmacro{\stp@Mmax}{0}%
  \xdef\stp@haveMmax{0}%
  \foreach \stp@k in {0,...,\stp@ns}{%
    \pgfmathsetmacro{\stp@xi}{\stp@k/\stp@ns}%
    \pgfmathsetmacro{\stp@Mval}{%
      \stp@Ms*(1-\stp@xi)+\stp@Me*\stp@xi
      -0.5*\stp@qy*\stp@L*\stp@L*\stp@xi*(1-\stp@xi)}%
    \pgfmathsetmacro{\stp@off}{\stp@Mval*\stp@mscl}%
    \coordinate (stp@mbase) at ($ (#2)!\stp@xi!(#3)$);%
    \coordinate (stp@mpt) at ($ (stp@mbase)!{\stp@off mm}!90:(#3)$);%
    \ifstpShowTeeth
      \pgfmathparse{int(Mod(\stp@k,\stp@teeth))}%
      \ifnum\pgfmathresult=0\relax
        \draw[stpMomentThin, color=\stp@mom@clr] (stp@mbase)--(stp@mpt);%
      \fi
    \fi
    \ifnum\stp@k=0\relax
      \coordinate (stp@mprev) at (stp@mpt);%
      \draw[stpMomentThin, color=\stp@mom@clr] (#2)--(stp@mpt);%
    \else
      \draw[stpMoment, color=\stp@mom@clr] (stp@mprev)--(stp@mpt);%
      \coordinate (stp@mprev) at (stp@mpt);%
    \fi
    \ifnum\stp@k=\stp@ns\relax
      \draw[stpMomentThin, color=\stp@mom@clr] (#3)--(stp@mpt);%
    \fi
    \pgfmathparse{abs(\stp@Mval)>=abs(\stp@Mmax)?1:0}%
    \ifnum\pgfmathresult=1\relax
      \xdef\stp@Mmax{\stp@Mval}%
      \xdef\stp@haveMmax{1}%
      \coordinate (stp@mmaxpt) at (stp@mpt);%
    \fi
  }%
  \ifstpShowMmax
    \ifnum\stp@haveMmax=1\relax
      \edef\stp@tmplab{\stp@mom@lab}%
      \ifx\stp@tmplab\stp@empty
        \node[stpLabel, text=\stp@mom@clr, anchor=south] at (stp@mmaxpt)
          {$M_{\max}=\pgfmathprintnumber[fixed,precision=1]{\stp@Mmax}$};%
      \else
        \node[stpLabel, text=\stp@mom@clr, anchor=south] at (stp@mmaxpt){\stp@mom@lab};%
      \fi
    \fi
  \fi}

%=============================================================================
% Deform
