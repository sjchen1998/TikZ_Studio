% Styles
%=============================================================================
\tikzset{
  % Color scheme on the drawing environment (faces keep soft red):
  %   \begin{tikzpicture}[stpScheme=color]  or  [stpScheme=bw]
  %   aliases: stpColor / stpBW
  stpScheme/.is choice,
  stpScheme/color/.code={\stp@applyScheme{color}},
  stpScheme/bw/.code={\stp@applyScheme{bw}},
  stpScheme/mono/.code={\stp@applyScheme{bw}},
  stpColor/.style={stpScheme=color},
  stpBW/.style={stpScheme=bw},
  stpHuge/.style={line width=\stpHugeLW},
  stpBig/.style={line width=\stpBigLW},
  stpNormal/.style={line width=\stpNormalLW},
  stpSmall/.style={line width=\stpSmallLW},
  stpTiny/.style={line width=\stpTinyLW},
  stpMember/.style={draw=\stpClrMember, line width=\stpHugeLW, line cap=round},
  stpTruss/.style={draw=\stpClrMember, line width=\stpBigLW, line cap=round},
  % Axial rod: same LW as truss; dark-blue (stpClrRod); thin end circles
  stpRod/.style={draw=\stpClrRod, line width=\stpBigLW, line cap=round},
  stpRodPin/.style={draw=\stpClrRod, line width=\stpTinyLW},
  stpGhost/.style={draw=\stpClrMember, line width=\stpNormalLW, dashed},
  stpFiber/.style={draw=\stpClrMember, line width=\stpSmallLW, dashed},
  % Point / line / moment loads: thin stroke + classic tip arrows (same as moment arc)
  stpLoad/.style={draw=\stpClrLoad, line width=\stpTinyLW, ->},
  stpLoadRev/.style={draw=\stpClrLoad, line width=\stpTinyLW, <-},
  stpLoadPlain/.style={draw=\stpClrLoad, line width=\stpTinyLW},
  % Uniform-load rails (tip + head connectors)
  stpLoadRail/.style={draw=\stpClrLoad, line width=\stpTinyLW},
  stpMomentArc/.style={draw=\stpClrLoad, line width=\stpTinyLW, <-},
  stpMomentArcCW/.style={draw=\stpClrLoad, line width=\stpTinyLW, ->},
  stpBC/.style={draw=\stpClrBC, line width=\stpNormalLW},
  stpSpringZig/.style={
    draw=\stpClrSpring, line width=\stpNormalLW, decorate,
    decoration={zigzag, amplitude=\stpSpringAmp, segment length=\stpSpringSeg,
      pre length=\stpSpringPre, post length=\stpSpringPost}},
  stpSpringCoil/.style={
    draw=\stpClrSpring, line width=\stpNormalLW, decorate,
    decoration={coil, amplitude=\stpCoilAmp, segment length=\stpCoilSeg,
      pre length=\stpCoilPre, post length=\stpCoilPost}},
  stpTor/.style={draw=\stpClrTor, line width=\stpNormalLW},
  % Diagram envelopes (moment/shear/axial): thin, never beam-weight
  stpMoment/.style={draw=\stpClrMoment, line width=\stpTinyLW},
  stpMomentThin/.style={draw=\stpClrMoment, line width=\stpTinyLW},
  stpShear/.style={draw=\stpClrShear, line width=\stpTinyLW},
  stpAxial/.style={draw=\stpClrAxial, line width=\stpTinyLW},
  stpDeform/.style={draw=\stpClrDeform, line width=\stpHugeLW, densely dashed},
  stpHatch/.style={
    draw=\stpClrHatch, line width=\stpTinyLW, decorate,
    decoration={border, angle=\stpHatchAngle, amplitude=\stpHatchAmp,
      segment length=\stpHatchSeg}},
  stpHatchSoft/.style={
    draw=\stpClrHatch, line width=\stpTinyLW, decorate,
    decoration={border, angle=\stpHatchAngle, amplitude=\stpHatchAmp/2,
      segment length=\stpHatchSeg/2}},
  stpLabel/.style={font=\footnotesize, inner sep=1pt},
  stpLoadLabel/.style={stpLabel, text=\stpClrLoadLabel},
  % Structure volume/mass box — anchor to current picture bbox (view/scale stable)
  stpMassBox/.style={
    font=\footnotesize\sffamily, align=left, inner sep=3pt, outer sep=2pt,
    fill=white, fill opacity=0.88, text opacity=1,
    draw=gray!55, line width=0.3pt, rounded corners=1pt},
  stpDim/.style={draw=\stpClrMember, line width=\stpTinyLW},
  % Spot weld: white fill + violet ring (readable on soft-red faces)
  stpSpotWeld/.style={
    draw=\stpClrWeld, fill=white, line width=\stpTinyLW},
  % Seam weld: zigzag (paper mm amplitude — view/scale stable)
  stpSeamWeld/.style={
    draw=\stpClrWeld, line width=\stpTinyLW, line cap=round,
    decorate, decoration={zigzag, amplitude=0.85mm, segment length=1.8mm,
      pre length=0.5mm, post length=0.5mm}},
  % Face fill: deeper soft red + contour
  stpFace/.style={
    draw=\stpClrFaceEdge,
    fill=\stpClrFace,
    fill opacity=\stpFaceOpacity,
    draw opacity=0.85,
    line width=\stpTinyLW,
    line join=round,
    line cap=round},
  stpDface/.style={
    draw=\stpClrFaceEdge,
    fill=\stpClrFace,
    fill opacity=\stpFaceOpacity,
    draw opacity=0.85,
    line width=\stpTinyLW,
    line join=round,
    line cap=round},
}

%=============================================================================
% Helpers
%=============================================================================
\newcommand{\stp@empty}{}
\def\stp@splitxy#1,#2\stp@end#3#4{\def#3{#1}\def#4{#2}}
\newcommand{\stp@unitxy}[1]{%
  \expandafter\stp@splitxy#1\stp@end\stp@rx\stp@ry
  \pgfmathsetmacro{\stp@ulen}{veclen(\stp@rx,\stp@ry)}%
  \pgfmathparse{\stp@ulen<1e-9?1:0}%
  \ifnum\pgfmathresult=1\relax\PackageError{satopdf}{Zero direction}{}\fi
  \pgfmathsetmacro{\stp@ux}{\stp@rx/\stp@ulen}%
  \pgfmathsetmacro{\stp@uy}{\stp@ry/\stp@ulen}%
}
\newcommand{\stp@tipmark}[2]{%
  \coordinate (#2) at ($ (#1)+({-\stpTipR*\stp@ux},{-\stpTipR*\stp@uy})$);%
  \ifstpShowTip
    \fill[white] (#1) circle[radius=\stpTipR];%
    \draw[stpLoadPlain] (#1) circle[radius=\stpTipR];%
  \fi
}
\newcommand{\stp@maskbit}[2]{%
  \ifcase#2\relax0%
  \or\stp@mb@i#1\stp@end\or\stp@mb@ii#1\stp@end\or\stp@mb@iii#1\stp@end
  \or\stp@mb@iv#1\stp@end\or\stp@mb@v#1\stp@end\or\stp@mb@vi#1\stp@end
  \else0\fi}
\def\stp@mb@i#1#2\stp@end{#1}
\def\stp@mb@ii#1#2#3\stp@end{#2}
\def\stp@mb@iii#1#2#3#4\stp@end{#3}
\def\stp@mb@iv#1#2#3#4#5\stp@end{#4}
\def\stp@mb@v#1#2#3#4#5#6\stp@end{#5}
\def\stp@mb@vi#1#2#3#4#5#6#7\stp@end{#6}

\newcommand{\stp@typeerr}[2]{%
  \PackageError{satopdf}{Bad #1 type: #2}{See satopdf documentation.}}

