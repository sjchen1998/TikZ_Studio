\newcommand{\stpScaling}[1]{\def\stp@scale{#1}}

\NewDocumentCommand{\stpPoint}{m m m}{%
  \pgfmathsetmacro{\stp@px}{#2*\stp@scale}%
  \pgfmathsetmacro{\stp@py}{#3*\stp@scale}%
