% Apply color or black/white scheme (faces unchanged)
\newcommand{\stp@applyScheme}[1]{%
  \def\stp@sch{#1}%
  \def\stp@schBW{bw}\def\stp@schMono{mono}\def\stp@schGray{gray}%
  \ifx\stp@sch\stp@schBW\def\stp@schUseBW{1}\else
  \ifx\stp@sch\stp@schMono\def\stp@schUseBW{1}\else
  \ifx\stp@sch\stp@schGray\def\stp@schUseBW{1}\else
    \def\stp@schUseBW{0}%
  \fi\fi\fi
  \ifnum\stp@schUseBW=1\relax
    \renewcommand{\stpClrMember}{black}%
    \renewcommand{\stpClrLoad}{black}%
    \renewcommand{\stpClrLoadLabel}{black}%
    \renewcommand{\stpClrBC}{black}%
    \renewcommand{\stpClrSpring}{black}%
    \renewcommand{\stpClrTor}{black}%
    \renewcommand{\stpClrMoment}{black}%
    \renewcommand{\stpClrShear}{black}%
    \renewcommand{\stpClrAxial}{black}%
    \renewcommand{\stpClrDeform}{black}%
    \renewcommand{\stpClrHatch}{black}%
    \renewcommand{\stpClrWeld}{black}%
    \renewcommand{\stpClrRod}{black}%
    % must stay a single named color — styles append !20/!30/!55
    \renewcommand{\stpClrGray}{gray}%
  \else
    \renewcommand{\stpClrMember}{black}%
    \renewcommand{\stpClrLoad}{red!75!black}%
    \renewcommand{\stpClrLoadLabel}{red!75!black}%
    \renewcommand{\stpClrBC}{teal!70!black}%
    \renewcommand{\stpClrSpring}{green!45!black}%
    \renewcommand{\stpClrTor}{magenta!70!black}%
    \renewcommand{\stpClrMoment}{orange!75!black}%
    \renewcommand{\stpClrShear}{blue!60!black}%
    \renewcommand{\stpClrAxial}{brown!70!black}%
    \renewcommand{\stpClrDeform}{magenta!55!black}%
    \renewcommand{\stpClrHatch}{black!65}%
    \renewcommand{\stpClrWeld}{violet!80!black}%
    \renewcommand{\stpClrRod}{blue!55!black}%
    \renewcommand{\stpClrGray}{gray}%
  \fi
}

\pgfkeys{
  /stp/.is family, /stp/.cd,
  scaling/.code={\def\stp@scale{#1}},
  tip radius/.code={\renewcommand{\stpTipR}{#1}},
  force length/.code={\renewcommand{\stpForceL}{#1}},
  lineload length/.code={\renewcommand{\stpLineShaft}{#1}},
  lineload count/.code={\renewcommand{\stpLineCount}{#1}},
  % #1 = supportBasicLength; other dims scale with fixed ratios
  %   BasicL:L:H:BasicH:Gap:HatchL:HatchH = 12:8:5:3.5:1:20:5
  support size/.code={%
    \pgfmathsetmacro{\stp@ss}{#1/12mm}%
    \renewcommand{\stpSupBasicL}{#1}%
    \pgfmathsetlengthmacro{\stp@sx}{\stp@ss*8mm}\edef\stpSupL{\stp@sx}%
    \pgfmathsetlengthmacro{\stp@sx}{\stp@ss*5mm}\edef\stpSupH{\stp@sx}%
    \pgfmathsetlengthmacro{\stp@sx}{\stp@ss*3.5mm}\edef\stpSupBasicH{\stp@sx}%
    \pgfmathsetlengthmacro{\stp@sx}{\stp@ss*1mm}\edef\stpSupGap{\stp@sx}%
    \pgfmathsetlengthmacro{\stp@sx}{\stp@ss*20mm}\edef\stpSupHatchL{\stp@sx}%
    \pgfmathsetlengthmacro{\stp@sx}{\stp@ss*5mm}\edef\stpSupHatchH{\stp@sx}%
    \pgfmathsetlengthmacro{\stp@sx}{0.5*\stpSupL}\edef\stpMomentDist{\stp@sx}%
  },
  hinge radius/.code={\renewcommand{\stpHingeR}{#1}},
  moment radius/.code={\renewcommand{\stpMomentDist}{#1}},
  moment scale/.code={\renewcommand{\stpMomScale}{#1}},
  moment segments/.code={\renewcommand{\stpMomSeg}{#1}},
  moment teeth/.code={\renewcommand{\stpMomTeeth}{#1}},
  deform scale/.code={\renewcommand{\stpDefScale}{#1}},
  % scheme=color|bw — prefer tikzpicture option stpScheme=…
  scheme/.code={\stp@applyScheme{#1}},
  dface shaft/.code={\renewcommand{\stpDFaceShaft}{#1}},
  show tip circle/.is if=stpShowTip,
  show moment teeth/.is if=stpShowTeeth,
  show max moment/.is if=stpShowMmax,
}
\newcommand{\stpset}[1]{\pgfkeys{/stp/.cd,#1}}

