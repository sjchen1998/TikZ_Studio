\NewDocumentCommand{\stpAddon}{m m m m O{1}}{%
  \stpValidTypefalse
  \def\stp@t{#1}%
  \def\stp@aSec{section}\def\stp@aAngle{angle}\def\stp@aArc{arc}%
  \ifx\stp@t\stp@aSec
    \coordinate (stp@aa) at ($ (#2)!#4!(#3)$);%
    \draw[stpSmall]
      ($ (stp@aa)!\stpDimBar/2!45:(#3)$)--($ (stp@aa)!\stpDimBar/2!225:(#3)$)
      ($ (stp@aa)!\stpDimBar/2!45:(#3)+(\stpSupGap,0)$)--
      ($ (stp@aa)!\stpDimBar/2!225:(#3)+(\stpSupGap,0)$);%
    \stpValidTypetrue
  \fi
  \ifx\stp@t\stp@aAngle
    \coordinate (stp@aa) at ($ (#2)!\stpDimBar!(#3)$);%
    \coordinate (stp@ab) at ($ (#2)!\stpDimBar!(#4)$);%
    \ifthenelse{\equal{#5}{1}}{%
      \coordinate (stp@ac) at ($ (stp@aa)!\stpDimBar!90:(#3)$);%
      \coordinate (stp@ad) at ($ (#2)!1.414*\stpDimBar/2!45:(#3)$);%
    }{%
      \coordinate (stp@ac) at ($ (stp@aa)!\stpDimBar!-90:(#3)$);%
      \coordinate (stp@ad) at ($ (#2)!1.414*\stpDimBar/2!-45:(#3)$);%
    }%
    \draw[stpSmall] (stp@aa)--(stp@ac)--(stp@ab);%
    \filldraw (stp@ad) circle (\stpSmallLW);%
    \stpValidTypetrue
  \fi
  \ifx\stp@t\stp@aArc
    \begin{scope}[even odd rule]
      \ifthenelse{\equal{#5}{1}}{%
        \clip (#2) circle (\stpDimBar+\stpNormalLW)
          (#2)--(#3)--($(#3)!\stpDimBar+\stpNormalLW!-90:(#2)$)--
          ($(#4)!\stpDimBar+\stpNormalLW!90:(#2)$)--(#4)--cycle;%
      }{%
        \clip (#2)--(#3)--($(#3)!\stpDimBar+\stpNormalLW!-90:(#2)$)--
          ($(#4)!\stpDimBar+\stpNormalLW!90:(#2)$)--(#4)--cycle;%
      }%
      \draw[stpSmall] (#2) circle (\stpDimBar)
        (#2) circle (\stpDimBar-2*\stpNormalLW);%
    \end{scope}%
    \stpValidTypetrue
  \fi
  \ifstpValidType\else\stp@typeerr{addon}{#1}\fi
}

