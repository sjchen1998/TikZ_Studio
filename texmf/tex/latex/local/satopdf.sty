\NewDocumentCommand{\stpDeform}{m m m m O{}}{%
  \if\relax\detokenize{#5}\relax
    \pgfmathsetmacro{\stp@ds}{\stpDefScale}%
  \else
    \pgfmathsetmacro{\stp@ds}{#5}%
  \fi
  \expandafter\stp@splitxy#3\stp@end\stp@uax\stp@uay
  \expandafter\stp@splitxy#4\stp@end\stp@ubx\stp@uby
  \pgfmathsetmacro{\stp@uax}{\stp@uax}%
  \pgfmathsetmacro{\stp@uay}{\stp@uay}%
  \pgfmathsetmacro{\stp@ubx}{\stp@ubx}%
  \pgfmathsetmacro{\stp@uby}{\stp@uby}%
  \coordinate (stp@dA) at ($ (#1)+({\stp@uax*\stp@ds},{\stp@uay*\stp@ds})$);%
  \coordinate (stp@dB) at ($ (#2)+({\stp@ubx*\stp@ds},{\stp@uby*\stp@ds})$);%
  \draw[stpDeform] (stp@dA)--(stp@dB);%
  \fill[color=\stpClrDeform] (stp@dA) circle (0.55*\stpTipR);%
  \fill[color=\stpClrDeform] (stp@dB) circle (0.55*\stpTipR);%
}

%=============================================================================
% Dimensioning  \stpDimensioning{horiz|vert|parallel}{A}{B}{offset}[text]
%=============================================================================
\NewDocumentCommand{\stpDimensioning}{m m m m O{}}{%
  \stpValidTypefalse
  \def\stp@t{#1}%
  \def\stp@dh{horiz}\def\stp@dv{vert}\def\stp@dp{parallel}%
  \ifx\stp@t\stp@dh
    \path let \p1=(#2), \p2=(#3) in
      coordinate (stp@da) at (\x1,#4)
      coordinate (stp@db) at (\x2,#4);%
    \draw[stpDim]
      (stp@da)--++(0,\stpDimBar/2)--++(0,-\stpDimBar)
      (stp@da)--++(\stpDimBar/4,\stpDimBar/4)--++(-\stpDimBar/2,-\stpDimBar/2)
      (stp@db)--++(0,\stpDimBar/2)--++(0,-\stpDimBar)
      (stp@db)--++(\stpDimBar/4,\stpDimBar/4)--++(-\stpDimBar/2,-\stpDimBar/2)
      (stp@da)--(stp@db) node[sloped,midway,above,stpLabel] {#5};%
    \stpValidTypetrue
  \fi
  \ifx\stp@t\stp@dv
    \path let \p1=(#2), \p2=(#3) in
      coordinate (stp@da) at (#4,\y1)
      coordinate (stp@db) at (#4,\y2);%
    \draw[stpDim]
      (stp@da)--++(\stpDimBar/2,0)--++(-\stpDimBar,0)
      (stp@da)--++(\stpDimBar/4,\stpDimBar/4)--++(-\stpDimBar/2,-\stpDimBar/2)
      (stp@db)--++(\stpDimBar/2,0)--++(-\stpDimBar,0)
      (stp@db)--++(\stpDimBar/4,\stpDimBar/4)--++(-\stpDimBar/2,-\stpDimBar/2)
      (stp@da)--(stp@db) node[sloped,midway,above,stpLabel] {#5};%
    \stpValidTypetrue
  \fi
  \ifx\stp@t\stp@dp
    % Offset may be unitless (fraction of |AB|) or a length (e.g. -5ex)
    \coordinate (stp@da) at ($ (#2)!{#4}!90:(#3)$);%
    \coordinate (stp@db) at ($ (#3)!{#4}!-90:(#2)$);%
    % End marks: short bar + diagonal tick
    \draw[stpDim]
      ($ (stp@da)!{-\stpDimBar/2}!90:(stp@db)$)--($ (stp@da)!{\stpDimBar/2}!90:(stp@db)$)
      ($ (stp@da)!{\stpDimBar/4}!45:(stp@db)$)--($ (stp@da)!{\stpDimBar/4}!225:(stp@db)$)
      ($ (stp@db)!{-\stpDimBar/2}!90:(stp@da)$)--($ (stp@db)!{\stpDimBar/2}!90:(stp@da)$)
      ($ (stp@db)!{\stpDimBar/4}!45:(stp@da)$)--($ (stp@db)!{\stpDimBar/4}!225:(stp@da)$)
      (stp@da)--(stp@db) node[sloped,midway,above,stpLabel] {#5};%
    \stpValidTypetrue
  \fi
  \ifstpValidType\else\stp@typeerr{dimensioning}{#1}\fi
}
\NewDocumentCommand{\stpDim}{m m m O{}}{\stpDimensioning{parallel}{#1}{#2}{#3}[#4]}
% Envelope helpers — offset in (…), default \stpDimOff; label in […]
%   \stpDimX{SW}{SE}[$L_x$]           \stpDimX{SW}{SE}(0.4cm)[$L_x$]
%   \stpDimY{SW}{NW}[$L_y$]           \stpDimY{SW}{NW}(0.5cm)[$L_y$]
\NewDocumentCommand{\stpDimX}{m m D(){\stpDimOff} O{}}{%
  \stpDimensioning{parallel}{#1}{#2}{-#3}[#4]}
\NewDocumentCommand{\stpDimY}{m m D(){\stpDimOff} O{}}{%
  \stpDimensioning{parallel}{#1}{#2}{#3}[#4]}

%=============================================================================
% Notation
% \stpNotation{node|tick|section|boxed|plain|circled}{…}
%=============================================================================
\NewDocumentCommand{\stpNotation}{m m m O{above right} O{0.5} O{above} O{sloped}}{%
  \stpValidTypefalse
  \def\stp@t{#1}%
  \def\stp@nn{node}\def\stp@nt{tick}\def\stp@ns{section}%
  \def\stp@nb{boxed}\def\stp@np{plain}\def\stp@nc{circled}%
  \ifx\stp@t\stp@nn
    \node[stpLabel,#4] at (#2) {#3};%
    \stpValidTypetrue
  \fi
  \ifx\stp@t\stp@nt
    \node[stpLabel,#4] at (#2) {#3};%
    \draw[stpBig] (#2)--++(0,\stpDimBar/2)--++(0,-\stpDimBar);%
    \stpValidTypetrue
  \fi
  \ifx\stp@t\stp@ns
    \coordinate (stp@na) at ($ (#2)!#5!(#3)$);%
    \draw[stpBig]
      ($ (stp@na)!\stpDimBar/2!90:(#3)$)--($ (stp@na)!\stpDimBar/2!-90:(#3)$);%
    \node[stpLabel,#6] at (stp@na) {#4};%
    \stpValidTypetrue
  \fi
  \ifx\stp@t\stp@nb
    \path (#2)--(#3)
      node[inner sep=0.6mm, rectangle, stpSmall, draw=\stpClrMember, fill=white,
        minimum size=2.5*\stpHingeR, midway, #6, #7, pos=#5] {#4};%
    \stpValidTypetrue
  \fi
  \ifx\stp@t\stp@np
    \path (#2)--(#3) node[midway,#6,#7,pos=#5,stpLabel] {#4};%
    \stpValidTypetrue
  \fi
  \ifx\stp@t\stp@nc
    \node[inner sep=0mm, circle, stpSmall, draw=\stpClrMember, fill=white,
      minimum size=2.5*\stpHingeR] at (#2) {#3};%
    \stpValidTypetrue
  \fi
  \ifstpValidType\else\stp@typeerr{notation}{#1}\fi
}

%=============================================================================
% Temperature, influence line, addon
%=============================================================================
\NewDocumentCommand{\stpTemperature}{m m m m O{0.5} O{} O{} O{below} O{above}}{%
  \coordinate (stp@ta) at ($ (#1)!#5!(#2)$);%
  \coordinate (stp@tb1) at ($ (stp@ta)!\stpTempH/2!90:(#2)$);%
  \coordinate (stp@tb2) at ($ (stp@ta)!-\stpTempH/2!90:(#2)$);%
  \coordinate (stp@tc1) at ($ (stp@tb2)!-#3!90:(stp@tb1)$);%
  \coordinate (stp@tc2) at ($ (stp@tb1)!#4!90:(stp@tb2)$);%
  \filldraw[fill=\stpClrGray!20, stpSmall]
    (stp@tb1)--(stp@tc2)--(stp@tc1)--(stp@tb2)--cycle;%
  \node[stpLabel,#8] at (stp@tc1) {#6};%
  \node[stpLabel,#9] at (stp@tc2) {#7};%
}

\NewDocumentCommand{\stpInfluenceLine}{m m m O{0.5}}{%
