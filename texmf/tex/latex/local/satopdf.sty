% Store 6 canvas components (already scaled by sx,sy,sz)
\newcommand{\stp@setDCanvas}[6]{%
  \edef\stp@t{#1}\expandafter\renewcommand\expandafter\stpDxx\expandafter{\stp@t}%
  \edef\stp@t{#2}\expandafter\renewcommand\expandafter\stpDxy\expandafter{\stp@t}%
  \edef\stp@t{#3}\expandafter\renewcommand\expandafter\stpDyx\expandafter{\stp@t}%
  \edef\stp@t{#4}\expandafter\renewcommand\expandafter\stpDyy\expandafter{\stp@t}%
  \edef\stp@t{#5}\expandafter\renewcommand\expandafter\stpDzx\expandafter{\stp@t}%
  \edef\stp@t{#6}\expandafter\renewcommand\expandafter\stpDzy\expandafter{\stp@t}%
}

% \stpDsetUp{ux}{uy}{uz} — default world-up for \stpDsetView / \stpDsetViewDir
\newcommand{\stpDsetUp}[3]{%
  \pgfmathsetmacro{\stp@ulen}{sqrt((#1)*(#1)+(#2)*(#2)+(#3)*(#3))}%
  \pgfmathparse{\stp@ulen<1e-12?1:0}%
  \ifnum\pgfmathresult=1\relax
    \PackageError{satopdf}{Zero up vector}{}%
  \fi
  \pgfmathsetmacro{\stp@ux}{(#1)/\stp@ulen}%
  \pgfmathsetmacro{\stp@uy}{(#2)/\stp@ulen}%
  \pgfmathsetmacro{\stp@uz}{(#3)/\stp@ulen}%
  \expandafter\renewcommand\expandafter\stpDUpX\expandafter{\stp@ux}%
  \expandafter\renewcommand\expandafter\stpDUpY\expandafter{\stp@uy}%
  \expandafter\renewcommand\expandafter\stpDUpZ\expandafter{\stp@uz}%
}

% Orthographic projection from VIEWDIR n and world-up û.
% Screen-right r = n×û (fallback if parallel); screen-up v = r×n.
% #4,#5,#6 = sx,sy,sz; #7,#8,#9 = up components.
\newcommand{\stp@viewDirToCanvas}[9]{%
  \pgfmathsetmacro{\stp@nx}{#1}%
  \pgfmathsetmacro{\stp@ny}{#2}%
  \pgfmathsetmacro{\stp@nz}{#3}%
  \pgfmathsetmacro{\stp@nlen}{sqrt(\stp@nx*\stp@nx+\stp@ny*\stp@ny+\stp@nz*\stp@nz)}%
  \pgfmathparse{\stp@nlen<1e-12?1:0}%
  \ifnum\pgfmathresult=1\relax
    \PackageError{satopdf}{Zero view direction}{}%
  \fi
  \pgfmathsetmacro{\stp@nx}{\stp@nx/\stp@nlen}%
  \pgfmathsetmacro{\stp@ny}{\stp@ny/\stp@nlen}%
  \pgfmathsetmacro{\stp@nz}{\stp@nz/\stp@nlen}%
  \pgfmathsetmacro{\stp@wx}{#7}%
  \pgfmathsetmacro{\stp@wy}{#8}%
  \pgfmathsetmacro{\stp@wz}{#9}%
  \pgfmathsetmacro{\stp@wlen}{sqrt(\stp@wx*\stp@wx+\stp@wy*\stp@wy+\stp@wz*\stp@wz)}%
  \pgfmathparse{\stp@wlen<1e-12?1:0}%
  \ifnum\pgfmathresult=1\relax
    \PackageError{satopdf}{Zero up vector}{}%
  \fi
  \pgfmathsetmacro{\stp@wx}{\stp@wx/\stp@wlen}%
  \pgfmathsetmacro{\stp@wy}{\stp@wy/\stp@wlen}%
  \pgfmathsetmacro{\stp@wz}{\stp@wz/\stp@wlen}%
  % r ← n × û
  \pgfmathsetmacro{\stp@rx}{\stp@ny*\stp@wz-\stp@nz*\stp@wy}%
  \pgfmathsetmacro{\stp@ry}{\stp@nz*\stp@wx-\stp@nx*\stp@wz}%
  \pgfmathsetmacro{\stp@rz}{\stp@nx*\stp@wy-\stp@ny*\stp@wx}%
  \pgfmathsetmacro{\stp@rlen}{sqrt(\stp@rx*\stp@rx+\stp@ry*\stp@ry+\stp@rz*\stp@rz)}%
  \pgfmathparse{\stp@rlen<1e-8?1:0}%
  \ifnum\pgfmathresult=1\relax
    % n ∥ û → alternate reference (prefer world Z, else world Y)
    \pgfmathparse{abs(\stp@wz)>0.9?1:0}%
    \ifnum\pgfmathresult=1\relax
      % û ≈ ±Z → use Y: n × Y = (-nz, 0, nx)
      \pgfmathsetmacro{\stp@rx}{-\stp@nz}%
      \pgfmathsetmacro{\stp@ry}{0}%
      \pgfmathsetmacro{\stp@rz}{\stp@nx}%
    \else
      % use Z: n × Z = (ny, -nx, 0)
      \pgfmathsetmacro{\stp@rx}{\stp@ny}%
      \pgfmathsetmacro{\stp@ry}{-\stp@nx}%
      \pgfmathsetmacro{\stp@rz}{0}%
    \fi
    \pgfmathsetmacro{\stp@rlen}{sqrt(\stp@rx*\stp@rx+\stp@ry*\stp@ry+\stp@rz*\stp@rz)}%
  \fi
  \pgfmathsetmacro{\stp@rx}{\stp@rx/\stp@rlen}%
  \pgfmathsetmacro{\stp@ry}{\stp@ry/\stp@rlen}%
  \pgfmathsetmacro{\stp@rz}{\stp@rz/\stp@rlen}%
  % v ← r × n  (screen up)
  \pgfmathsetmacro{\stp@vx}{\stp@ry*\stp@nz-\stp@rz*\stp@ny}%
  \pgfmathsetmacro{\stp@vy}{\stp@rz*\stp@nx-\stp@rx*\stp@nz}%
  \pgfmathsetmacro{\stp@vz}{\stp@rx*\stp@ny-\stp@ry*\stp@nx}%
  \pgfmathsetmacro{\stp@vlen}{sqrt(\stp@vx*\stp@vx+\stp@vy*\stp@vy+\stp@vz*\stp@vz)}%
  \pgfmathsetmacro{\stp@vx}{\stp@vx/\stp@vlen}%
  \pgfmathsetmacro{\stp@vy}{\stp@vy/\stp@vlen}%
  \pgfmathsetmacro{\stp@vz}{\stp@vz/\stp@vlen}%
  % TikZ unit axes = (ê·r, ê·v) * scale
  \pgfmathsetmacro{\stp@cxx}{#4*\stp@rx}%
  \pgfmathsetmacro{\stp@cxy}{#4*\stp@vx}%
  \pgfmathsetmacro{\stp@cyx}{#5*\stp@ry}%
  \pgfmathsetmacro{\stp@cyy}{#5*\stp@vy}%
  \pgfmathsetmacro{\stp@czx}{#6*\stp@rz}%
  \pgfmathsetmacro{\stp@czy}{#6*\stp@vz}%
  \stp@setDCanvas{\stp@cxx}{\stp@cxy}{\stp@cyx}{\stp@cyy}{\stp@czx}{\stp@czy}%
}

% Parse optional up "ux,uy,uz" or empty → current \stpDUp*
\def\stp@parseUp#1{\stp@parseUpA#1\@nil}
\def\stp@parseUpA#1,#2,#3\@nil{%
  \def\stp@upx{#1}\def\stp@upy{#2}\def\stp@upz{#3}%
}
\newcommand{\stp@resolveUp}[1]{%
  \def\stp@tmp{#1}%
  \ifx\stp@tmp\stp@empty
    \edef\stp@upx{\stpDUpX}\edef\stp@upy{\stpDUpY}\edef\stp@upz{\stpDUpZ}%
  \else
    \stp@parseUp{#1}%
  \fi
}

% \stpDsetViewDir{dx}{dy}{dz}[sx][sy][sz][ux,uy,uz]  — AutoCAD VIEWDIR
\NewDocumentCommand{\stpDsetViewDir}{m m m O{1} O{1} O{1} O{}}{%
  \stp@resolveUp{#7}%
  \stp@viewDirToCanvas{#1}{#2}{#3}{#4}{#5}{#6}{\stp@upx}{\stp@upy}{\stp@upz}%
}

% \stpDsetView{vx}{vy}{vz}[sx][sy][sz][ux,uy,uz]  — AutoCAD VPOINT (eye → origin)
\NewDocumentCommand{\stpDsetView}{m m m O{1} O{1} O{1} O{}}{%
  \stp@resolveUp{#7}%
  \stp@viewDirToCanvas{-#1}{-#2}{-#3}{#4}{#5}{#6}{\stp@upx}{\stp@upy}{\stp@upz}%
}

% \stpDsetCoords{x-ang}{y-ang}[Dx][Dy][Dz][z-ang]
% Paper angles of the three axes (oblique projection). Lengths are
% foreshortening; a negative length is folded into angle+180.
% Right-hand rule: with z pointing “up” on the page (sin z-ang > 0),
% +x→+y must be CCW; if the given angles are CW, y is mirrored across
% x (same |Δ|) so the triad stays right-handed.
\NewDocumentCommand{\stpDsetCoords}{m m O{1} O{1} O{1} O{90}}{%
  \pgfmathsetmacro{\stp@xa}{#1}%
  \pgfmathsetmacro{\stp@ya}{#2}%
  \pgfmathsetmacro{\stp@za}{#6}%
  \pgfmathsetmacro{\stp@Dx}{#3}%
  \pgfmathsetmacro{\stp@Dy}{#4}%
  \pgfmathsetmacro{\stp@Dz}{#5}%
  % Fold negative foreshortening into the axis angle
  \pgfmathparse{\stp@Dx<0}%
  \ifnum\pgfmathresult=1\relax
    \pgfmathsetmacro{\stp@xa}{\stp@xa+180}%
    \pgfmathsetmacro{\stp@Dx}{-\stp@Dx}%
  \fi
  \pgfmathparse{\stp@Dy<0}%
  \ifnum\pgfmathresult=1\relax
    \pgfmathsetmacro{\stp@ya}{\stp@ya+180}%
    \pgfmathsetmacro{\stp@Dy}{-\stp@Dy}%
  \fi
  \pgfmathparse{\stp@Dz<0}%
  \ifnum\pgfmathresult=1\relax
    \pgfmathsetmacro{\stp@za}{\stp@za+180}%
    \pgfmathsetmacro{\stp@Dz}{-\stp@Dz}%
  \fi
  % Δ(y−x) ∈ (−180,180]; need sign(sin Δ) == sign(sin z) for RH
  \pgfmathsetmacro{\stp@del}{Mod(\stp@ya-\stp@xa+180,360)-180}%
  \pgfmathsetmacro{\stp@sdel}{sin(\stp@del)}%
  \pgfmathsetmacro{\stp@sza}{sin(\stp@za)}%
  \pgfmathparse{abs(\stp@sdel)>1e-6 && abs(\stp@sza)>1e-6 && (\stp@sdel*\stp@sza)<0}%
  \ifnum\pgfmathresult=1\relax
    \pgfmathsetmacro{\stp@ya}{\stp@xa-\stp@del}%
  \fi
  \expandafter\renewcommand\expandafter\stpDxAng\expandafter{\stp@xa}%
  \expandafter\renewcommand\expandafter\stpDyAng\expandafter{\stp@ya}%
  \expandafter\renewcommand\expandafter\stpDzAng\expandafter{\stp@za}%
  \expandafter\renewcommand\expandafter\stpDxLen\expandafter{\stp@Dx}%
  \expandafter\renewcommand\expandafter\stpDyLen\expandafter{\stp@Dy}%
  \expandafter\renewcommand\expandafter\stpDzLen\expandafter{\stp@Dz}%
  % Polar → canvas components for stpDCoords
  \pgfmathsetmacro{\stp@cxx}{\stp@Dx*cos(\stp@xa)}%
  \pgfmathsetmacro{\stp@cxy}{\stp@Dx*sin(\stp@xa)}%
  \pgfmathsetmacro{\stp@cyx}{\stp@Dy*cos(\stp@ya)}%
  \pgfmathsetmacro{\stp@cyy}{\stp@Dy*sin(\stp@ya)}%
  \pgfmathsetmacro{\stp@czx}{\stp@Dz*cos(\stp@za)}%
  \pgfmathsetmacro{\stp@czy}{\stp@Dz*sin(\stp@za)}%
  \stp@setDCanvas{\stp@cxx}{\stp@cxy}{\stp@cyx}{\stp@cyy}{\stp@czx}{\stp@czy}%
}

% \stpDsetAxis{xyz|XYZ|custom}[…] — label scheme for \stpDaxis
\NewDocumentCommand{\stpDsetAxis}{m O{$x$} O{$y$} O{$z$} O{$x^\prime$} O{$y^\prime$} O{$z^\prime$}}{%
  \def\stp@ax{#1}%
  \def\stp@axxyz{xyz}\def\stp@axXYZ{XYZ}%
  \ifx\stp@ax\stp@axxyz
    \renewcommand{\stpDxLab}{$x$}\renewcommand{\stpDyLab}{$y$}\renewcommand{\stpDzLab}{$z$}%
    \renewcommand{\stpDxLabLoc}{$x^\prime$}\renewcommand{\stpDyLabLoc}{$y^\prime$}%
    \renewcommand{\stpDzLabLoc}{$z^\prime$}%
  \else\ifx\stp@ax\stp@axXYZ
    \renewcommand{\stpDxLab}{$X$}\renewcommand{\stpDyLab}{$Y$}\renewcommand{\stpDzLab}{$Z$}%
    \renewcommand{\stpDxLabLoc}{$x$}\renewcommand{\stpDyLabLoc}{$y$}\renewcommand{\stpDzLabLoc}{$z$}%
  \else
    \renewcommand{\stpDxLab}{#2}\renewcommand{\stpDyLab}{#3}\renewcommand{\stpDzLab}{#4}%
    \renewcommand{\stpDxLabLoc}{#5}\renewcommand{\stpDyLabLoc}{#6}%
    \renewcommand{\stpDzLabLoc}{#7}%
  \fi\fi
}

\newcommand{\stpDshowPoint}{\stpDshowPointtrue}

% \stpDpoint{name}{x}{y}{z}  — args may be macros; expand via pgfmath first
\NewDocumentCommand{\stpDpoint}{m m m m}{%
  \pgfmathsetmacro{\stp@px}{(#2)*\stpDscale}%
  \pgfmathsetmacro{\stp@py}{(#3)*\stpDscale}%
  \pgfmathsetmacro{\stp@pz}{(#4)*\stpDscale}%
  \node[coordinate] (#1) at (\stp@px,\stp@py,\stp@pz) {};%
  \ifstpDshowPoint
    \draw (\stp@px,\stp@py,\stp@pz) node[above,red,stpLabel] {#1};%
  \fi
}
% CAE-style: \stpDnode{name}{x,y,z}
\NewDocumentCommand{\stpDnode}{m m}{%
  \edef\stp@dn{#2}%
  \expandafter\stp@dnodeA\expandafter{\stp@dn}{#1}%
}
\def\stp@dnodeA#1#2{\stp@dnodeB#1\@nil{#2}}
\def\stp@dnodeB#1,#2,#3\@nil#4{\stpDpoint{#4}{#1}{#2}{#3}}

% \stpDmember{beam|truss|rod|ghost}{A}{B}[endA][endB]
%   beam: thick; optional solid end dots (1=dot)
%   truss: medium; optional hollow hinges (0=draw default)
%   rod: dark-blue axial; thin full DOF circles at ends by default (0);
%        for multi-beam joints use \stpDrodPin{gap}{…} and pass [1] on that end
%   ghost: dashed
\newcommand{\stp@DrodPinFull}[1]{%
  \fill[white] (#1) circle[radius=\stpDhingeR];%
  \draw[stpDrodPin] (#1) circle[radius=\stpDhingeR];%
}
\NewDocumentCommand{\stpDmember}{m m m O{0} O{0}}{%
  \stpValidTypefalse
  \def\stp@t{#1}%
  \def\stp@tb{beam}\def\stp@tt{truss}\def\stp@tr{rod}\def\stp@tg{ghost}%
  \ifx\stp@t\stp@tb
    \draw[stpDmember] (#2)--(#3);%
    \ifthenelse{\equal{#4}{0}}{}{\fill[color=\stpClrMember] (#2) circle (\stpNormalLW/2);}%
    \ifthenelse{\equal{#5}{0}}{}{\fill[color=\stpClrMember] (#3) circle (\stpNormalLW/2);}%
    \stpValidTypetrue
  \fi
  \ifx\stp@t\stp@tt
    \draw[stpDtruss] (#2)--(#3);%
    \ifthenelse{\equal{#4}{0}}{%
      \fill[white] (#2) circle[radius=\stpDhingeR];%
      \draw[stpNormal] (#2) circle[radius=\stpDhingeR];%
    }{}%
    \ifthenelse{\equal{#5}{0}}{%
      \fill[white] (#3) circle[radius=\stpDhingeR];%
      \draw[stpNormal] (#3) circle[radius=\stpDhingeR];%
    }{}%
    \stpValidTypetrue
  \fi
  \ifx\stp@t\stp@tr
    \draw[stpDrod] (#2)--(#3);%
    \ifthenelse{\equal{#4}{0}}{\stp@DrodPinFull{#2}}{}%
    \ifthenelse{\equal{#5}{0}}{\stp@DrodPinFull{#3}}{}%
    \stpValidTypetrue
  \fi
  \ifx\stp@t\stp@tg
    \draw[stpDghost] (#2)--(#3);%
    \stpValidTypetrue
  \fi
  \ifstpValidType\else\stp@typeerr{Dmember}{#1}\fi
}
\newcommand{\stpDrod}[2]{\stpDmember{rod}{#1}{#2}}

% \stpDrodPin{full|gap}{point}[beamA][beamB][orient]
%   full — thin solid hollow circle (default)
%   gap  — partial circle; orient 0|1 selects which side (same as \stpDhinge{gap})
\NewDocumentCommand{\stpDrodPin}{m m O{0} O{0} O{0}}{%
  \stpValidTypefalse
  \def\stp@t{#1}%
  \def\stp@rf{full}\def\stp@rg{gap}%
  \ifx\stp@t\stp@rf
    \stp@DrodPinFull{#2}%
    \stpValidTypetrue
  \fi
  \ifx\stp@t\stp@rg
    \pgfmathsetlengthmacro{\stp@dhr}{\stpDhingeBigR+\stpTinyLW}%
    \begin{scope}[even odd rule]
      \begin{pgfinterruptboundingbox}
      \ifthenelse{\equal{#5}{1}}{%
        \clip (#2) circle (\stp@dhr)
          (#2)--(#3)--($(#3)!\stp@dhr!-90:(#2)$)--
          ($(#4)!\stp@dhr!90:(#2)$)--(#4)--cycle;%
      }{%
        \clip (#2)--(#3)--($(#3)!\stp@dhr!-90:(#2)$)--
          ($(#4)!\stp@dhr!90:(#2)$)--(#4)--cycle;%
      }%
      \end{pgfinterruptboundingbox}%
      \filldraw[fill=white,stpDrodPin] (#2) circle[radius=\stpDhingeBigR];%
    \end{scope}%
    \draw[stpDmember] ($ (#2)!\stpDhingeBigR!(#3)$)--(#2)--($ (#2)!\stpDhingeBigR!(#4)$);%
    \stpValidTypetrue
  \fi
  \ifstpValidType\else\stp@typeerr{DrodPin}{#1}\fi
}

% \stpDaxis{point}[labX][labY][labZ]
\NewDocumentCommand{\stpDaxis}{m O{below} O{above} O{above}}{%
  \draw[stpDaxis] (#1)--++(\stpDaxLen,0,0) node[#2] {\stpDxLab};%
  \draw[stpDaxis] (#1)--++(0,\stpDaxLen,0) node[#3] {\stpDyLab};%
  \draw[stpDaxis] (#1)--++(0,0,\stpDaxLen) node[#4] {\stpDzLab};%
}

% \stpDsupport{type}{point}[…]
%   pin/wall/spring/fork — translation rods + rotation circles at rod ends:
%     [ux][uy][uz][rx][ry][rz]  each 1|0|-1 (u defaults 1; r defaults 0)
%     u≠0 → solid rod + circle (fill by r); u=0 & r≠0 → dashed stub + solid circle
%     solid circle = rotation about that axis constrained
%     hollow circle = rotation about that axis free
%   fixed — plane cross; [plane][normal-coord] (legacy)
% Hollow black circle at the support node (same size/LW as rot-end BC marks)
\newcommand{\stp@DnodeMark}[1]{%
  \fill[white] (#1) circle[radius=0.5*\stpDhingeR];%
  \draw[line width=\stpTinyLW] (#1) circle[radius=0.5*\stpDhingeR];%
}
\newcommand{\stp@DrotMark}[2]{%
  % #1=position, #2=1 light-filled (rot fixed) / 0 hollow (rot free)
  \ifthenelse{\equal{#2}{0}}{%
    \fill[white] (#1) circle[radius=0.5*\stpDhingeR];%
    \draw[stpDbcRing] (#1) circle[radius=0.5*\stpDhingeR];%
  }{%
    \fill[\stpClrGray!30] (#1) circle[radius=0.5*\stpDhingeR];%
    \draw[stpDbcRing] (#1) circle[radius=0.5*\stpDhingeR];%
  }%
}
% Axis mark: #2=u (rod), #3=r (fill), #4/#5/#6 = end offset factors of L along x/y/z
% u≠0 → solid rod; u=0 & r≠0 → dashed stub to solid circle (rot only)
\newcommand{\stp@DaxisMark}[6]{%
  \ifthenelse{\equal{#2}{0}}{%
    \ifthenelse{\equal{#3}{0}}{}{%
      \draw[stpDbcDash] (#1)--++(-\stpDsupLen*#4,-\stpDsupLen*#5,-\stpDsupLen*#6);%
      \stp@DrotMark{$ (#1)+(-\stpDsupLen*#4,-\stpDsupLen*#5,-\stpDsupLen*#6) $}{1}%
    }%
  }{%
    \draw[stpDbc] (#1)--++(-\stpDsupLen*#2*#4,-\stpDsupLen*#2*#5,-\stpDsupLen*#2*#6);%
    \stp@DrotMark{$ (#1)+(-\stpDsupLen*#2*#4,-\stpDsupLen*#2*#5,-\stpDsupLen*#2*#6) $}{#3}%
  }%
}
\newcommand{\stp@DaxisMarkSpr}[6]{%
  \ifthenelse{\equal{#2}{0}}{%
    \ifthenelse{\equal{#3}{0}}{}{%
      \draw[stpDbcDash] (#1)--++(-\stpDsupLen*#4,-\stpDsupLen*#5,-\stpDsupLen*#6);%
      \stp@DrotMark{$ (#1)+(-\stpDsupLen*#4,-\stpDsupLen*#5,-\stpDsupLen*#6) $}{1}%
    }%
  }{%
    \draw[stpDspring] (#1)--++(-\stpDsupLen*#2*#4,-\stpDsupLen*#2*#5,-\stpDsupLen*#2*#6);%
    \stp@DrotMark{$ (#1)+(-\stpDsupLen*#2*#4,-\stpDsupLen*#2*#5,-\stpDsupLen*#2*#6) $}{#3}%
  }%
}
\newcommand{\stp@DrodWall}[7]{%
  \stp@DaxisMark{#1}{#2}{#5}{1}{0}{0}%
  \stp@DaxisMark{#1}{#3}{#6}{0}{1}{0}%
  \stp@DaxisMark{#1}{#4}{#7}{0}{0}{1}%
}
\newcommand{\stp@DrodSpring}[7]{%
  \stp@DaxisMarkSpr{#1}{#2}{#5}{1}{0}{0}%
  \stp@DaxisMarkSpr{#1}{#3}{#6}{0}{1}{0}%
  \stp@DaxisMarkSpr{#1}{#4}{#7}{0}{0}{1}%
}

\NewDocumentCommand{\stpDsupport}{m m O{1} O{1} O{1} O{0} O{0} O{0}}{%
  \stpValidTypefalse
  \edef\stp@t{#1}%
  \def\stp@sPin{pin}\def\stp@sFixed{fixed}\def\stp@sSpr{spring}%
  \def\stp@sFork{fork}\def\stp@sWall{wall}%
  \ifx\stp@t\stp@sPin
    \stp@DrodWall{#2}{#3}{#4}{#5}{#6}{#7}{#8}%
    \stp@DnodeMark{#2}%
    \stpValidTypetrue
  \fi
  \ifx\stp@t\stp@sWall
    \stp@DrodWall{#2}{#3}{#4}{#5}{#6}{#7}{#8}%
    \stp@DnodeMark{#2}%
    \stpValidTypetrue
  \fi
  \ifx\stp@t\stp@sSpr
    \stp@DrodSpring{#2}{#3}{#4}{#5}{#6}{#7}{#8}%
    \stp@DnodeMark{#2}%
    \stpValidTypetrue
  \fi
  \ifx\stp@t\stp@sFork
    \ifthenelse{\equal{#3}{0}}{%
      \ifthenelse{\equal{#6}{0}}{}{%
        \draw[stpDbcDash] ($ (#2)+(0,0,-\stpDhingeAxH*2/3)$)--++(-\stpDsupLen,0,0);%
        \stp@DrotMark{$ (#2)+(-\stpDsupLen,0,-\stpDhingeAxH*2/3) $}{1}%
      }%
    }{%
      \draw[stpDbc] ($ (#2)+(0,0,-\stpDhingeAxH*2/3)$)--++(-\stpDsupLen*#3,0,0);%
      \stp@DrotMark{$ (#2)+(-\stpDsupLen*#3,0,-\stpDhingeAxH*2/3) $}{#6}%
    }%
    \ifthenelse{\equal{#4}{0}}{%
      \ifthenelse{\equal{#7}{0}}{}{%
        \draw[stpDbcDash] ($ (#2)+(0,0,-\stpDhingeAxH*2/3)$)--++(0,-\stpDsupLen,0);%
        \stp@DrotMark{$ (#2)+(0,-\stpDsupLen,-\stpDhingeAxH*2/3) $}{1}%
      }%
    }{%
      \draw[stpDbc] ($ (#2)+(0,0,-\stpDhingeAxH*2/3)$)--++(0,-\stpDsupLen*#4,0);%
      \stp@DrotMark{$ (#2)+(0,-\stpDsupLen*#4,-\stpDhingeAxH*2/3) $}{#7}%
    }%
    \ifthenelse{\equal{#5}{0}}{%
      \ifthenelse{\equal{#8}{0}}{}{%
        \draw[stpDbcDash] ($ (#2)+(0,0,-\stpDhingeAxH/2.5)$)--++(0,0,-\stpDsupLen);%
        \stp@DrotMark{$ (#2)+(0,0,-\stpDsupLen) $}{1}%
      }%
    }{%
      \draw[stpDbc] ($ (#2)+(0,0,-\stpDhingeAxH/2.5)$)
        --++(0,0,-\stpDsupLen*#5+\stpDhingeAxH/2);%
      \stp@DrotMark{$ (#2)+(0,0,-\stpDsupLen*#5) $}{#8}%
    }%
    \stp@DnodeMark{#2}%
    \stpValidTypetrue
  \fi
  \ifx\stp@t\stp@sFixed
    % #3=plane (xy|xz|yz|…), #4=normal coordinate through point
    \edef\stp@pl{#3}%
    \def\stp@pxy{xy}\def\stp@pyx{yx}\def\stp@pxz{xz}%
    \def\stp@pzx{zx}\def\stp@pyz{yz}\def\stp@pzy{zy}%
    \def\stp@nax{z}%
    \ifx\stp@pl\stp@pxy\def\stp@nax{z}\fi
    \ifx\stp@pl\stp@pyx\def\stp@nax{z}\fi
    \ifx\stp@pl\stp@pxz\def\stp@nax{y}\fi
    \ifx\stp@pl\stp@pzx\def\stp@nax{y}\fi
    \ifx\stp@pl\stp@pyz\def\stp@nax{x}\fi
    \ifx\stp@pl\stp@pzy\def\stp@nax{x}\fi
    \begin{scope}[canvas is #3 plane at \stp@nax=#4]
      \draw[stpDbc] (#2)--++(-\stpDsupLen/2,0)--++(\stpDsupLen,0);%
      \draw[stpDbc] (#2)--++(0,-\stpDsupLen/2)--++(0,\stpDsupLen);%
    \end{scope}%
    \stp@DnodeMark{#2}%
    \stpValidTypetrue
  \fi
  \ifstpValidType\else\stp@typeerr{Dsupport}{#1}\fi
}

% \stpDhinge{full|gap|corner}{point}[beamA][beamB][orient]
%   gap orient: 0 = one side, 1 = other
\NewDocumentCommand{\stpDhinge}{m m O{0} O{0} O{0}}{%
  \stpValidTypefalse
  \def\stp@t{#1}%
  \def\stp@hFull{full}\def\stp@hGap{gap}\def\stp@hCorn{corner}%
  \ifx\stp@t\stp@hFull
    \fill[white] (#2) circle[radius=\stpDhingeR];%
    \draw[stpNormal] (#2) circle[radius=\stpDhingeR];%
    \stpValidTypetrue
  \fi
  \ifx\stp@t\stp@hGap
    \pgfmathsetlengthmacro{\stp@dhr}{\stpDhingeBigR+\stpNormalLW}%
    \begin{scope}[even odd rule]
      % Clip polygon may reference far orient points — keep them out of the bbox
      \begin{pgfinterruptboundingbox}
      \ifthenelse{\equal{#5}{1}}{%
        \clip (#2) circle (\stp@dhr)
          (#2)--(#3)--($(#3)!\stp@dhr!-90:(#2)$)--
          ($(#4)!\stp@dhr!90:(#2)$)--(#4)--cycle;%
      }{%
        \clip (#2)--(#3)--($(#3)!\stp@dhr!-90:(#2)$)--
          ($(#4)!\stp@dhr!90:(#2)$)--(#4)--cycle;%
      }%
      \end{pgfinterruptboundingbox}%
      \filldraw[fill=white,stpNormal] (#2) circle[radius=\stpDhingeBigR];%
    \end{scope}%
    \draw[stpDmember] ($ (#2)!\stpDhingeBigR!(#3)$)--(#2)--($ (#2)!\stpDhingeBigR!(#4)$);%
    \stpValidTypetrue
  \fi
  \ifx\stp@t\stp@hCorn
    \coordinate (stp@dha) at ($ (#2)!\stpHingeCornerL!(#3)$);%
    \coordinate (stp@dhb) at ($ (#2)!\stpHingeCornerL!(#4)$);%
    \fill[black] (#2)--(stp@dha)--(stp@dhb)--cycle;%
    \fill[black] (#2) circle (\stpNormalLW/2);%
    \stpValidTypetrue
  \fi
  \ifstpValidType\else\stp@typeerr{Dhinge}{#1}\fi
}

% \stpDlineload{A}{B}[dx,dy,dz][count][shaft][label]
% Uniform line load along AB; (dx,dy,dz) = force direction (arrows point that way).
% Same comb as 2D: tip rail + head rail + arrows at both ends.
\NewDocumentCommand{\stpDlineload}{m m O{0,0,-1} O{5} O{0.55} O{}}{%
  \edef\stp@dd{#3}%
  \expandafter\stp@DldDir\expandafter{\stp@dd}%
  \pgfmathsetmacro{\stp@dox}{-\stp@ddx*#5}%
  \pgfmathsetmacro{\stp@doy}{-\stp@ddy*#5}%
  \pgfmathsetmacro{\stp@doz}{-\stp@ddz*#5}%
  \pgfmathsetmacro{\stp@dgx}{-\stp@ddx*\stpDldGap}%
  \pgfmathsetmacro{\stp@dgy}{-\stp@ddy*\stpDldGap}%
  \pgfmathsetmacro{\stp@dgz}{-\stp@ddz*\stpDldGap}%
  \coordinate (stp@dla) at (#1);%
  \coordinate (stp@dlb) at (#2);%
  \coordinate (stp@dlta) at ($ (stp@dla)+(\stp@dgx,\stp@dgy,\stp@dgz) $);%
  \coordinate (stp@dltb) at ($ (stp@dlb)+(\stp@dgx,\stp@dgy,\stp@dgz) $);%
  \coordinate (stp@dlha) at ($ (stp@dla)+(\stp@dox,\stp@doy,\stp@doz) $);%
  \coordinate (stp@dlhb) at ($ (stp@dlb)+(\stp@dox,\stp@doy,\stp@doz) $);%
  % Arrows first (include ends), then rails on top so the comb baseline is clear
  \pgfmathtruncatemacro{\stp@dln}{#4}%
  \ifnum\stp@dln=1
    \draw[stpLoad] ($ (stp@dlha)!0.5!(stp@dlhb) $)--($ (stp@dlta)!0.5!(stp@dltb) $);%
  \else
    \pgfmathtruncatemacro{\stp@dlm}{\stp@dln-1}%
    \foreach \stp@i in {0,...,\stp@dlm} {%
      \pgfmathsetmacro{\stp@t}{\stp@i/\stp@dlm}%
      \draw[stpLoad]
        ($ (stp@dlha)!\stp@t!(stp@dlhb) $)--($ (stp@dlta)!\stp@t!(stp@dltb) $);%
    }%
  \fi
  \draw[stpLoadRail] (stp@dlta)--(stp@dltb);%
  \draw[stpLoadRail] (stp@dlha)--(stp@dlhb);%
  \fill[color=\stpClrLoad] (stp@dlha) circle (\stpTinyLW/2);%
  \fill[color=\stpClrLoad] (stp@dlhb) circle (\stpTinyLW/2);%
  \def\stp@dllab{#6}%
  \ifx\stp@dllab\stp@empty\else
    \node[stpLoadLabel, above=1mm] at ($ (stp@dlha)!0.5!(stp@dlhb) $) {#6};%
  \fi
}
\def\stp@DldDir#1{\stp@DldDirA#1\@nil}
\def\stp@DldDirA#1,#2,#3\@nil{%
  \def\stp@ddx{#1}\def\stp@ddy{#2}\def\stp@ddz{#3}%
}
\newcommand{\stpDldGap}{0.08}

% \stpDpointload{point}{dx,dy,dz}[shaft][label]
% 3D nodal force ≡ SETPTLOAD (CAE_VIS_LOAD text F[START|END]=…)
\NewDocumentCommand{\stpDpointload}{m m O{\stpDFaceShaft} O{}}{%
  \edef\stp@dd{#2}%
  \expandafter\stp@DldDir\expandafter{\stp@dd}%
  \pgfmathsetmacro{\stp@flen}{sqrt(\stp@ddx*\stp@ddx+\stp@ddy*\stp@ddy+\stp@ddz*\stp@ddz)}%
  \pgfmathparse{\stp@flen<1e-9?1:0}%
  \ifnum\pgfmathresult=1\relax\PackageError{satopdf}{Zero point-load direction}{}\fi
  \pgfmathsetmacro{\stp@fox}{-\stp@ddx/\stp@flen*#3}%
  \pgfmathsetmacro{\stp@foy}{-\stp@ddy/\stp@flen*#3}%
  \pgfmathsetmacro{\stp@foz}{-\stp@ddz/\stp@flen*#3}%
  \coordinate (stp@ppc) at (#1);%
  \coordinate (stp@pptail) at ($ (stp@ppc)+(\stp@fox,\stp@foy,\stp@foz) $);%
  \draw[stpLoad] (stp@pptail)--(stp@ppc);%
  \def\stp@tmp{#4}%
  \ifx\stp@tmp\stp@empty\else
    \node[stpLoadLabel, above=1mm] at (stp@pptail) {#4};%
  \fi
}

%=============================================================================
% Faces / shells — soft red fill (fixed; not toggled by stpScheme)
% 2D face geometry only (2D face-load API to be defined separately):
%   \stpFace{A,B,C[,D…]}
% 3D shell + face load (CAE SETSHELLLOAD → Face / FACE_PRESSURE|FACE_TOTAL_FORCE):
%   \stpDface{A,B,C[,D…]}
%   \stpDfaceload{A,B,C[,D…]}{dx,dy,dz}[shaft][label]
%     one arrow at face centroid (same as create-shell-faceload-block)
%     VIS text: P_face=… / F_total=… (ux,uy,uz) on layer CAE_VIS_LOAD
%=============================================================================

\newcommand{\stp@faceCentroid}[1]{%
  \foreach \stp@p [count=\stp@fi] in {#1} {%
    \ifnum\stp@fi=1
      \coordinate (stp@fcen) at (\stp@p);%
    \else
      \coordinate (stp@fcen) at ($ (stp@fcen)!{1/\stp@fi}!(\stp@p) $);%
    \fi
  }%
}

\newcommand{\stp@faceBuildPath}[1]{%
  \gdef\stp@fpath{}%
  \gdef\stp@fn{0}%
  \foreach \stp@p [count=\stp@fi] in {#1} {%
    \ifnum\stp@fi=1
      \xdef\stp@fpath{(\stp@p)}%
    \else
      \xdef\stp@fpath{\stp@fpath--(\stp@p)}%
    \fi
    \xdef\stp@fn{\stp@fi}%
  }%
  \ifnum\stp@fn<3\relax
    \PackageError{satopdf}{Face needs ≥3 nodes (got \stp@fn)}{}%
  \fi
  \xdef\stp@fpath{\stp@fpath--cycle}%
}

\newcommand{\stpFace}[1]{%
  \stp@faceBuildPath{#1}%
  \edef\stp@fdcmd{\noexpand\filldraw[stpFace] \stp@fpath;}%
  \stp@fdcmd
}

\newcommand{\stpDface}[1]{%
  \stp@faceBuildPath{#1}%
  \edef\stp@fdcmd{\noexpand\filldraw[stpDface] \stp@fpath;}%
  \stp@fdcmd
}

% 3D face load ≡ SETSHELLLOAD Face (single arrow at geometric centre)
\NewDocumentCommand{\stpDfaceload}{m m O{\stpDFaceShaft} O{}}{%
  \stp@faceCentroid{#1}%
  \edef\stp@dd{#2}%
  \expandafter\stp@DldDir\expandafter{\stp@dd}%
  \pgfmathsetmacro{\stp@flen}{sqrt(\stp@ddx*\stp@ddx+\stp@ddy*\stp@ddy+\stp@ddz*\stp@ddz)}%
  \pgfmathparse{\stp@flen<1e-9?1:0}%
  \ifnum\pgfmathresult=1\relax\PackageError{satopdf}{Zero face-load direction}{}\fi
  \pgfmathsetmacro{\stp@fox}{-\stp@ddx/\stp@flen*#3}%
  \pgfmathsetmacro{\stp@foy}{-\stp@ddy/\stp@flen*#3}%
  \pgfmathsetmacro{\stp@foz}{-\stp@ddz/\stp@flen*#3}%
  \coordinate (stp@fpc) at (stp@fcen);%
  \coordinate (stp@fptail) at ($ (stp@fpc)+(\stp@fox,\stp@foy,\stp@foz) $);%
  \draw[stpLoad] (stp@fptail)--(stp@fpc);%
  \def\stp@tmp{#4}%
  \ifx\stp@tmp\stp@empty\else
    \node[stpLoadLabel, above=1mm] at (stp@fptail) {#4};%
  \fi
}

\newcommand{\stpStubPlate}[1]{\stpFace{#1}}
\newcommand{\stpStubShell}[1]{\stpDface{#1}}

%-----------------------------------------------------------------------------
% 3D envelope dimension
%   \stpDdimEnv{x|y|z}{x0}{y0}{z0}{len}(Δ)[label]
%     from corner (x0,y0,z0) along axis by len; Δ = paper offset (default \stpDimOff)
%     Lx @ y0−Δ;  Ly @ x0−Δ;  Lz @ (x0−Δ,y0−Δ)
%   \stpDdimEnv{x}{0}{0}{0}{800}[$L_x=800mm$]
%   \stpDdimEnv{y}{0}{0}{0}{6000}(0.4cm)[$L_y=6000mm$]
%-----------------------------------------------------------------------------
\newcommand{\stpDdimDelta}{1.6}% paper cm (diagnostic)
\newcommand{\stpDimDeltaModel}{0.75}%
\newcommand{\stpDimDeltaModelX}{0.75}%
\newcommand{\stpDimDeltaModelY}{0.75}%
\newcommand{\stpDimDeltaModelZ}{0.75}%
% Default \stpDimOff = 5×\small 字高 — measure outside tikzpicture (nullfont)
\AtBeginDocument{%
  \begingroup\normalfont\small
    \setlength{\stp@dimEx}{5em}%
    \ifdim\stp@dimEx<0.1pt\stp@dimEx=1.6cm\fi
    \pgfmathsetmacro{\stp@offcm}{\stp@dimEx/1cm}%
    \xdef\stpDimOff{\stp@offcm cm}%
    \global\let\stpDdimDelta\stp@offcm
  \endgroup
}
% Refresh foreshortening → model Δ for paper length \stpDimOff (or current scale)
\newcommand{\stpInitDimDelta}{%
  \pgfmathsetmacro{\stp@xl}{max(0.25,sqrt(\stpDxx*\stpDxx+\stpDxy*\stpDxy))}%
  \pgfmathsetmacro{\stp@yl}{max(0.25,sqrt(\stpDyx*\stpDyx+\stpDyy*\stpDyy))}%
  \pgfmathsetmacro{\stp@zl}{max(0.25,sqrt(\stpDzx*\stpDzx+\stpDzy*\stpDzy))}%
  \pgfmathsetmacro{\stp@pap}{\stpDimOff/1cm}%
  \global\let\stpDdimDelta\stp@pap
  \pgfmathsetmacro{\stp@dmx}{\stp@pap/(\stp@xl*\stpDscale)}%
  \pgfmathsetmacro{\stp@dmy}{\stp@pap/(\stp@yl*\stpDscale)}%
  \pgfmathsetmacro{\stp@dmz}{\stp@pap/(\stp@zl*\stpDscale)}%
  \global\let\stpDimDeltaModelX\stp@dmx
  \global\let\stpDimDeltaModelY\stp@dmy
  \global\let\stpDimDeltaModelZ\stp@dmz
  \global\let\stpDimDeltaModel\stp@dmy
}
% paper length → model offset along world axis a∈{x,y,z}
\newcommand{\stp@paperToModel}[2]{%
  \pgfmathsetmacro{\stp@xl}{max(0.25,sqrt(\stpDxx*\stpDxx+\stpDxy*\stpDxy))}%
  \pgfmathsetmacro{\stp@yl}{max(0.25,sqrt(\stpDyx*\stpDyx+\stpDyy*\stpDyy))}%
  \pgfmathsetmacro{\stp@zl}{max(0.25,sqrt(\stpDzx*\stpDzx+\stpDzy*\stpDzy))}%
  \pgfmathsetmacro{\stp@pap}{(#1)/1cm}%
  \def\stp@axa{#2}%
  \def\stp@axX{x}\def\stp@axY{y}\def\stp@axZ{z}%
  \ifx\stp@axa\stp@axX
    \pgfmathsetmacro{\stp@dmod}{\stp@pap/(\stp@xl*\stpDscale)}%
  \else
    \ifx\stp@axa\stp@axY
      \pgfmathsetmacro{\stp@dmod}{\stp@pap/(\stp@yl*\stpDscale)}%
    \else
      \pgfmathsetmacro{\stp@dmod}{\stp@pap/(\stp@zl*\stpDscale)}%
    \fi
  \fi
}
\NewDocumentCommand{\stpDdimEnv}{m m m m m D(){\stpDimOff} O{}}{%
  \def\stp@ax{#1}%
  \def\stp@axX{x}\def\stp@axY{y}\def\stp@axZ{z}%
  \ifx\stp@ax\stp@axX
    % Lx on XY @ z=z0, y = y0 − Δ_Y
    \stp@paperToModel{#6}{y}%
    \pgfmathsetmacro{\stp@dimyo}{#3-\stp@dmod}%
    \pgfmathsetmacro{\stp@dimxa}{#2}%
    \pgfmathsetmacro{\stp@dimxb}{#2+#5}%
    \stpDpoint{stp@dO}{\stp@dimxa}{#3}{#4}%
    \stpDpoint{stp@dE}{\stp@dimxb}{#3}{#4}%
    \stpDpoint{stp@da}{\stp@dimxa}{\stp@dimyo}{#4}%
    \stpDpoint{stp@db}{\stp@dimxb}{\stp@dimyo}{#4}%
    \stpDdimHelp{stp@dO}{stp@da}{stp@dE}{stp@db}%
    \stpDdimSeg{stp@da}{stp@db}[#7]%
  \fi
  \ifx\stp@ax\stp@axY
    % Ly on XY @ z=z0, x = x0 − Δ_X
    \stp@paperToModel{#6}{x}%
    \pgfmathsetmacro{\stp@dimxo}{#2-\stp@dmod}%
    \pgfmathsetmacro{\stp@dimya}{#3}%
    \pgfmathsetmacro{\stp@dimyb}{#3+#5}%
    \stpDpoint{stp@dO}{#2}{\stp@dimya}{#4}%
    \stpDpoint{stp@dE}{#2}{\stp@dimyb}{#4}%
    \stpDpoint{stp@da}{\stp@dimxo}{\stp@dimya}{#4}%
    \stpDpoint{stp@db}{\stp@dimxo}{\stp@dimyb}{#4}%
    \stpDdimHelp{stp@dO}{stp@da}{stp@dE}{stp@db}%
    \stpDdimSeg{stp@da}{stp@db}[#7]%
  \fi
  \ifx\stp@ax\stp@axZ
    % Lz on YZ @ x=x0−Δx, y=y0−Δy (same paper Δ)
    \stp@paperToModel{#6}{x}%
    \pgfmathsetmacro{\stp@dimxo}{#2-\stp@dmod}%
    \stp@paperToModel{#6}{y}%
    \pgfmathsetmacro{\stp@dimyo}{#3-\stp@dmod}%
    \pgfmathsetmacro{\stp@dimza}{#4}%
    \pgfmathsetmacro{\stp@dimzb}{#4+#5}%
    \stpDpoint{stp@dO}{#2}{#3}{\stp@dimza}%
    \stpDpoint{stp@dE}{#2}{#3}{\stp@dimzb}%
    \stpDpoint{stp@da}{\stp@dimxo}{\stp@dimyo}{\stp@dimza}%
    \stpDpoint{stp@db}{\stp@dimxo}{\stp@dimyo}{\stp@dimzb}%
    \stpDdimHelp{stp@dO}{stp@da}{stp@dE}{stp@db}%
    \stpDdimSeg{stp@da}{stp@db}[#7]%
  \fi
}
% Ticks + dimension line between two named 3D points
\NewDocumentCommand{\stpDdimSeg}{m m O{}}{%
  \draw[stpDim]
    ($ (#1)!{-\stpDimBar/2}!90:(#2)$)--($ (#1)!{\stpDimBar/2}!90:(#2)$)
    ($ (#1)!{\stpDimBar/4}!45:(#2)$)--($ (#1)!{\stpDimBar/4}!225:(#2)$)
    ($ (#2)!{-\stpDimBar/2}!90:(#1)$)--($ (#2)!{\stpDimBar/2}!90:(#1)$)
    ($ (#2)!{\stpDimBar/4}!45:(#1)$)--($ (#2)!{\stpDimBar/4}!225:(#1)$)
    (#1)--(#2) node[sloped,midway,above,stpLabel] {#3};%
}
\NewDocumentCommand{\stpDdimHelp}{m m m m}{%
  \draw[stpDim, densely dotted, line width=\stpTinyLW] (#1)--(#2) (#3)--(#4);%
}

%-----------------------------------------------------------------------------
% Structure volume / mass annotation (paper / canvas corner, not model coords)
% Place once at end of tikzpicture. Uses current bounding box → stays at the
% upper-right when 2D scale (x=/y=) or 3D \stpDsetView / figure size changes.
%   \stpStructInfo{$V=\ldots$}{$m=\ldots$}
%-----------------------------------------------------------------------------
\newcommand{\stpStructInfo}[2]{%
  \node[stpMassBox, anchor=north east]
    at ($(current bounding box.north east)+(-1.5pt,-1.5pt)$)
    {#1\\[0.15em]#2};%
}
\newcommand{\stpDstructInfo}[2]{\stpStructInfo{#1}{#2}}

%=============================================================================
% Welds — Spot (点焊) & Seam (满焊)
% 2D:  \stpSpotWeld{node}[radius][label]
%      \stpSeamWeld{A}{B}[label]
%      \stpSeamWeldPath{N1,N2,...}[label]
% 3D:  \stpDspotWeld / \stpDseamWeld / \stpDseamWeldPath  (same args; follow view)
% Radius / zigzag amplitude are paper mm — not scaled by \stpDscale.
%=============================================================================
\newcommand{\stpWeldR}{1.35mm}
\NewDocumentCommand{\stpSpotWeld}{m O{\stpWeldR} O{}}{%
  \fill[white] (#1) circle[radius=#2];%
  \draw[stpSpotWeld] (#1) circle[radius=#2];%
  \draw[draw=\stpClrWeld, line width=\stpTinyLW]
    ($ (#1)+(-#2,0)$)--($ (#1)+(#2,0)$)
    ($ (#1)+(0,-#2)$)--($ (#1)+(0,#2)$);%
  \def\stp@wlab{#3}%
  \ifx\stp@wlab\stp@empty\else
    \node[stpLabel, text=\stpClrWeld, above right=1mm] at (#1) {#3};%
  \fi
}
\NewDocumentCommand{\stpDspotWeld}{m O{\stpWeldR} O{}}{%
  \stpSpotWeld{#1}[#2][#3]%
}
\NewDocumentCommand{\stpSeamWeld}{m m O{}}{%
  \draw[stpSeamWeld] (#1)--(#2);%
  \def\stp@wlab{#3}%
  \ifx\stp@wlab\stp@empty\else
    \node[stpLabel, text=\stpClrWeld, above=1.2mm] at ($ (#1)!0.5!(#2)$) {#3};%
  \fi
}
\NewDocumentCommand{\stpDseamWeld}{m m O{}}{%
  \stpSeamWeld{#1}{#2}[#3]%
}
\NewDocumentCommand{\stpSeamWeldPath}{m O{}}{%
  \gdef\stp@wpath{}%
  \foreach \stp@wp [count=\stp@wi] in {#1} {%
    \ifnum\stp@wi=1
      \xdef\stp@wpath{(\stp@wp)}%
      \coordinate (stp@wmid) at (\stp@wp);%
    \else
      \xdef\stp@wpath{\stp@wpath--(\stp@wp)}%
    \fi
  }%
  \edef\stp@wdcmd{\noexpand\draw[stpSeamWeld] \stp@wpath;}%
  \stp@wdcmd
  \def\stp@wlab{#2}%
  \ifx\stp@wlab\stp@empty\else
    \node[stpLabel, text=\stpClrWeld, above=1.2mm] at (stp@wmid) {#2};%
  \fi
}
\NewDocumentCommand{\stpDseamWeldPath}{m O{}}{%
  \stpSeamWeldPath{#1}[#2]%
}

\endinput
