(defun c:REFRESH_ALL (/ ssOld i cDist cPt cBc cComp cSec)
  (unlock-vis-layer)
  (setq ssOld (ssget "_X" '((8 . "CAE_VIS_LOAD,CAE_VIS_BC,CAE_VIS_SEC,CAE_LOAD_VIS"))))
  (if ssOld
    (progn
      (setq i 0)
      (while (< i (sslength ssOld))
        (entdel (ssname ssOld i))
        (setq i (1+ i))
      )
    )
  )
  (setq cDist (refresh-dist-loads)
        cPt   (refresh-point-loads)
        cBc   (refresh-simple-bcs)
        cComp (refresh-comp-bcs)
        cSec  (refresh-sections))
  (lock-vis-layer)
  (princ (strcat "\n[刷新完成] 截面=" (itoa cSec)
                 " | 分布力=" (itoa cDist)
                 " | 集中力=" (itoa cPt)
                 " | 简单约束=" (itoa cBc)
                 " | 复合约束=" (itoa cComp)))
  (princ)
)

(defun c:SETSCALE (/ sLoad sBc sSec)
  (princ (strcat "\n当前比例 载荷:" (rtos *CAE_SCALE_LOAD* 2 2)
                 " 约束:" (rtos *CAE_SCALE_BC* 2 2)
                 " 截面:" (rtos *CAE_SCALE_SEC* 2 2)))
  (setq sLoad (getreal (strcat "\n【载荷】比例 <" (rtos *CAE_SCALE_LOAD* 2 2) ">: ")))
  (if (and sLoad (> sLoad 0.0)) (setq *CAE_SCALE_LOAD* sLoad))
  (setq sBc (getreal (strcat "\n【约束】比例 <" (rtos *CAE_SCALE_BC* 2 2) ">: ")))
  (if (and sBc (> sBc 0.0)) (setq *CAE_SCALE_BC* sBc))
  (setq sSec (getreal (strcat "\n【截面】比例 <" (rtos *CAE_SCALE_SEC* 2 2) ">: ")))
  (if (and sSec (> sSec 0.0)) (setq *CAE_SCALE_SEC* sSec))
  (princ "\n正在按新比例重绘...")
  (c:REFRESH_ALL)
)

;;; ---------- 图层显隐 ----------
(defun toggle-cae-layer (layName cnLabel / layData colVal)
  (setq layData (tblsearch "LAYER" layName))
  (if layData
    (progn
      (setq colVal (cdr (assoc 62 layData)))
      (if (< colVal 0)
        (progn (command "_.-LAYER" "_ON" layName "")
               (princ (strcat "\n[显示] " cnLabel)))
        (progn (command "_.-LAYER" "_OFF" layName "")
               (princ (strcat "\n[隐藏] " cnLabel)))
      )
    )
    (princ (strcat "\n[提示] 图层 " layName " 尚未创建。"))
  )
  (princ)
)
(defun c:TOGGLESEC () (toggle-cae-layer "CAE_VIS_SEC" "截面"))
(defun c:TOGGLELOAD () (toggle-cae-layer "CAE_VIS_LOAD" "载荷"))
(defun c:TOGGLEBC () (toggle-cae-layer "CAE_VIS_BC" "约束"))

