(register-all-cae-apps)
(lock-vis-layer)
(princ "\n[CAE梁] 已加载。")
(princ "\n  载荷: SETLOAD / DELLOAD / SETPTLOAD / DELPTLOAD")
(princ "\n  约束: SETBC / DELBC / ADDBC")
(princ "\n  截面: SETSEC / DELSEC")
(princ "\n  显示: REFRESH_ALL / SETSCALE / TOGGLELOAD / TOGGLEBC / TOGGLESEC")
(princ)
